        A("ACTIVO: clic para soltar", "", "ACTIVE: click to release", "AKTIV: klicken zum Loslassen", "ATIVO: clique para soltar", "АКТИВЕН: нажмите, чтобы отпустить", "已激活：点击释放", "作動中：クリックで解除")
