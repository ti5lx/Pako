        A("AYUDA_COLORES", "Lista: rojo = dirigido a ti, verde = CQ, amarillo = tu TX." & vbCrLf & "Violeta = país nuevo, lila = país nuevo en esta banda," & vbCrLf & "celeste = grid nuevo, verde pálido = ya trabajado." & vbCrLf & "Barra verde = en tu frecuencia de RX." & vbCrLf & "Waterfall: clic izq = RX, clic der = TX, Ctrl+clic = ambos.", "List: red = to you, green = CQ, yellow = your TX." & vbCrLf & "Violet = new country, lilac = new country on this band," & vbCrLf & "light blue = new grid, pale green = already worked." & vbCrLf & "Green bar = on your RX frequency." & vbCrLf & "Waterfall: left click = RX, right click = TX, Ctrl+click = both.", "Liste: rot = an dich, grün = CQ, gelb = dein TX." & vbCrLf & "Violett = neues Land, lila = neues Land auf diesem Band," & vbCrLf & "hellblau = neues Grid, blassgrün = schon gearbeitet." & vbCrLf & "Grüner Balken = auf deiner RX-Frequenz." & vbCrLf & "Wasserfall: links = RX, rechts = TX, Strg+Klick = beide.", "Lista: vermelho = para você, verde = CQ, amarelo = seu TX." & vbCrLf & "Violeta = país novo, lilás = país novo nesta banda," & vbCrLf & "azul-claro = grid novo, verde-claro = já trabalhado." & vbCrLf & "Barra verde = na sua frequência de RX." & vbCrLf & "Cascata: clique esq. = RX, dir. = TX, Ctrl+clique = ambos.", "Список: красный = вам, зелёный = CQ, жёлтый = ваш TX." & vbCrLf & "Фиолетовый = новая страна, сиреневый = новая на диапазоне," & vbCrLf & "голубой = новый квадрат, бледно-зелёный = уже проведён." & vbCrLf & "Зелёная полоса = на вашей частоте RX." & vbCrLf & "Водопад: левый клик = RX, правый = TX, Ctrl+клик = оба.", "列表：红色 = 发给你，绿色 = CQ，黄色 = 你的发射。" & vbCrLf & "紫色 = 新国家，淡紫 = 本波段新国家，" & vbCrLf & "浅蓝 = 新网格，淡绿 = 已通联。" & vbCrLf & "绿条 = 在你的接收频率上。" & vbCrLf & "瀑布图：左键 = 接收，右键 = 发射，Ctrl+点击 = 两者。", "リスト：赤 = あなた宛て、緑 = CQ、黄 = あなたの送信。" & vbCrLf & "紫 = 新エンティティ、薄紫 = このバンドで新、" & vbCrLf & "水色 = 新グリッド、薄緑 = 交信済み。" & vbCrLf & "緑のバー = あなたの受信周波数上。" & vbCrLf & "ウォーターフォール：左クリック = RX、右 = TX、Ctrl = 両方。")
