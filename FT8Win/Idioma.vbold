    Private Sub Cargar7()
        ' JTTY
        A("JTTY: escuchando (1200 a 1800 Hz y tu frecuencia RX)", "", "JTTY: listening (1200 to 1800 Hz and your RX frequency)", "JTTY: Empfang (1200 bis 1800 Hz und deine RX-Frequenz)", "JTTY: escutando (1200 a 1800 Hz e sua frequência RX)", "JTTY: приём (1200–1800 Гц и ваша частота RX)", "JTTY：接收中（1200 至 1800 Hz 以及你的接收频率）", "JTTY：受信中（1200～1800 Hz と RX 周波数）")
        A("TU TRANSMISION en JTTY a las {0:HH:mm:ss} UTC", "TU TRANSMISIÓN en JTTY a las {0:HH:mm:ss} UTC", "YOUR JTTY TRANSMISSION at {0:HH:mm:ss} UTC", "DEINE JTTY-SENDUNG um {0:HH:mm:ss} UTC", "SUA TRANSMISSÃO em JTTY às {0:HH:mm:ss} UTC", "ВАША ПЕРЕДАЧА JTTY в {0:HH:mm:ss} UTC", "你的 JTTY 发射，{0:HH:mm:ss} UTC", "あなたの JTTY 送信 {0:HH:mm:ss} UTC")
        A("Mensaje JTTY recibido a las {0:HH:mm:ss} UTC", "", "JTTY message received at {0:HH:mm:ss} UTC", "JTTY-Nachricht empfangen um {0:HH:mm:ss} UTC", "Mensagem JTTY recebida às {0:HH:mm:ss} UTC", "Сообщение JTTY принято в {0:HH:mm:ss} UTC", "{0:HH:mm:ss} UTC 收到的 JTTY 消息", "{0:HH:mm:ss} UTC に受信した JTTY メッセージ")
        A("Mensaje completo (llego la marca de fin).", "Mensaje completo (llegó la marca de fin).", "Complete message (the end mark was received).", "Vollständige Nachricht (Endmarke empfangen).", "Mensagem completa (chegou a marca de fim).", "Сообщение полное (получена метка конца).", "消息完整（已收到结束标记）。", "メッセージ完了（終了マークを受信）。")
        A("Mensaje en curso o cortado: el texto puede seguir creciendo.", "", "Message in progress or cut off: the text may keep growing.", "Nachricht läuft noch oder ist abgebrochen: Der Text kann noch wachsen.", "Mensagem em andamento ou cortada: o texto pode continuar crescendo.", "Сообщение ещё идёт или оборвалось: текст может продолжиться.", "消息仍在接收或已中断：文字可能继续增加。", "受信中または途切れたメッセージ：文字が増える場合があります。")
        A("QSO en JTTY con {0} guardado en el log local (los servicios en linea aun no aceptan JTTY)", "QSO en JTTY con {0} guardado en el log local (los servicios en línea aún no aceptan JTTY)", "JTTY QSO with {0} saved in the local log (online services do not accept JTTY yet)", "JTTY-QSO mit {0} im lokalen Log gespeichert (Online-Dienste akzeptieren JTTY noch nicht)", "QSO em JTTY com {0} salvo no log local (os serviços online ainda não aceitam JTTY)", "JTTY QSO с {0} сохранено в локальном журнале (онлайн-сервисы пока не принимают JTTY)", "与 {0} 的 JTTY 通联已保存到本地日志（在线服务尚不接受 JTTY）", "{0} との JTTY QSO をローカルログに保存しました（オンラインサービスは JTTY 未対応）")
        A("Mensaje (Enter = transmitir ya)", "", "Message (Enter = transmit now)", "Nachricht (Enter = sofort senden)", "Mensagem (Enter = transmitir já)", "Сообщение (Enter = передать сразу)", "消息（回车 = 立即发射）", "メッセージ（Enter = すぐ送信）")
        A("JTTY: escribe y presiona Enter, o usa F1 a F4. Doble clic en un mensaje para contestar.", "", "JTTY: type and press Enter, or use F1 to F4. Double-click a message to answer.", "JTTY: Text eingeben und Enter drücken oder F1 bis F4 benutzen. Doppelklick auf eine Nachricht zum Antworten.", "JTTY: escreva e pressione Enter, ou use F1 a F4. Clique duplo em uma mensagem para responder.", "JTTY: введите текст и нажмите Enter или используйте F1–F4. Двойной щелчок по сообщению — ответить.", "JTTY：输入后按回车，或使用 F1 至 F4。双击消息即可回答。", "JTTY：入力して Enter、または F1～F4。メッセージをダブルクリックで応答。")
        A("No se encuentra jtty_pako.dll junto a Pako.exe.", "", "jtty_pako.dll was not found next to Pako.exe.", "jtty_pako.dll wurde neben Pako.exe nicht gefunden.", "jtty_pako.dll não foi encontrado junto ao Pako.exe.", "Файл jtty_pako.dll не найден рядом с Pako.exe.", "在 Pako.exe 旁边找不到 jtty_pako.dll。", "Pako.exe と同じフォルダーに jtty_pako.dll がありません。")
        A("jtty_pako.dll es de 64 bits: compila Pako para x64.", "", "jtty_pako.dll is 64-bit: Pakö must run as a 64-bit (x64) program.", "jtty_pako.dll ist 64-Bit: Pakö muss als 64-Bit-Programm (x64) laufen.", "jtty_pako.dll é de 64 bits: o Pakö precisa rodar em 64 bits (x64).", "jtty_pako.dll — 64-разрядная: Pakö должен работать как 64-разрядная программа (x64).", "jtty_pako.dll 是 64 位的：Pakö 必须以 64 位（x64）运行。", "jtty_pako.dll は 64 ビットです：Pakö を 64 ビット（x64）で実行してください。")
        A("No se puede usar JTTY: {0}", "", "JTTY cannot be used: {0}", "JTTY kann nicht benutzt werden: {0}", "Não é possível usar JTTY: {0}", "Невозможно использовать JTTY: {0}", "无法使用 JTTY：{0}", "JTTY を使用できません：{0}")
        A("JTTY: el decodificador se detuvo ({0})", "", "JTTY: the decoder stopped ({0})", "JTTY: Der Decoder wurde angehalten ({0})", "JTTY: o decodificador parou ({0})", "JTTY: декодер остановился ({0})", "JTTY：解码器已停止（{0}）", "JTTY：デコーダーが停止しました（{0}）")
        A("No veo un indicativo en ese mensaje: escribe tu respuesta y presiona Enter.", "", "No callsign found in that message: type your answer and press Enter.", "Kein Rufzeichen in dieser Nachricht gefunden: Antwort eingeben und Enter drücken.", "Não vejo um indicativo nessa mensagem: escreva sua resposta e pressione Enter.", "В этом сообщении не найден позывной: введите ответ и нажмите Enter.", "该消息中没有找到呼号：请输入你的回答并按回车。", "このメッセージにコールサインが見つかりません：返事を入力して Enter を押してください。")
        A("Listo para {0}: presiona Enter para transmitir.", "", "Ready for {0}: press Enter to transmit.", "Bereit für {0}: Enter drücken zum Senden.", "Pronto para {0}: pressione Enter para transmitir.", "Готово для {0}: нажмите Enter для передачи.", "已为 {0} 准备好：按回车发射。", "{0} 宛の準備完了：Enter で送信。")
        A("Llamar", "", "Call", "Anruf", "Chamar", "Вызов", "呼叫", "呼出")
        A("Primero doble clic en un mensaje de la estacion (o escribe el mensaje a mano).", "Primero doble clic en un mensaje de la estación (o escribe el mensaje a mano).", "First double-click a message from the station (or type the message by hand).", "Zuerst auf eine Nachricht der Station doppelklicken (oder die Nachricht von Hand eingeben).", "Primeiro dê um clique duplo em uma mensagem da estação (ou escreva a mensagem à mão).", "Сначала дважды щёлкните по сообщению станции (или введите сообщение вручную).", "请先双击该电台的一条消息（或手动输入消息）。", "まず相手局のメッセージをダブルクリックしてください（または手入力）。")
        A("Ya hay una transmision en curso (Esc o 'Cancelar TX' para cortarla).", "Ya hay una transmisión en curso (Esc o 'Cancelar TX' para cortarla).", "A transmission is already in progress (Esc or 'Cancel TX' to stop it).", "Es läuft bereits eine Sendung (Esc oder 'TX abbrechen' zum Stoppen).", "Já há uma transmissão em andamento (Esc ou 'Cancelar TX' para interromper).", "Передача уже идёт (Esc или 'Отмена TX', чтобы прервать).", "已有发射正在进行（按 Esc 或「取消发射」中止）。", "すでに送信中です（Esc または「送信中止」で停止）。")
        A("Ese texto no se puede enviar en JTTY (maximo {0} caracteres).", "Ese texto no se puede enviar en JTTY (máximo {0} caracteres).", "That text cannot be sent in JTTY (maximum {0} characters).", "Dieser Text kann in JTTY nicht gesendet werden (höchstens {0} Zeichen).", "Esse texto não pode ser enviado em JTTY (máximo {0} caracteres).", "Этот текст нельзя передать в JTTY (не более {0} знаков).", "该文字无法用 JTTY 发送（最多 {0} 个字符）。", "このテキストは JTTY で送信できません（最大 {0} 文字）。")
        A("TX terminada. Escuchando...", "", "TX finished. Listening...", "Sendung beendet. Empfang...", "TX terminada. Escutando...", "Передача окончена. Приём...", "发射结束。接收中...", "送信終了。受信中...")
        A("Clic o tecla F{0}: transmite este mensaje al momento.", "", "Click or F{0} key: transmits this message right away.", "Klick oder Taste F{0}: sendet diese Nachricht sofort.", "Clique ou tecla F{0}: transmite esta mensagem na hora.", "Щелчок или клавиша F{0}: сразу передаёт это сообщение.", "单击或按 F{0} 键：立即发射此消息。", "クリックまたは F{0} キー：このメッセージをすぐ送信。")
    End Sub
End Module
