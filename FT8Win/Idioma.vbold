    Private Sub Cargar5()
        A("{0} siguio con otra estacion o volvio a llamar CQ.", "{0} siguió con otra estación o volvió a llamar CQ.", "{0} went on with another station or called CQ again.", "{0} arbeitet mit einer anderen Station weiter oder ruft wieder CQ.", "{0} seguiu com outra estação ou voltou a chamar CQ.", "{0} перешёл к другой станции или снова зовёт CQ.", "{0} 已转向其他电台或重新呼叫 CQ。", "{0} は別の局に移ったか、再び CQ を出しています。")
        A("{0} ya estaba en el log: subiendolo a {1}...", "{0} ya estaba en el log: subiéndolo a {1}...", "{0} was already in the log: uploading it to {1}...", "{0} war schon im Log: wird zu {1} hochgeladen...", "{0} já estava no log: enviando para {1}...", "{0} уже был в журнале: загрузка в {1}...", "{0} 已在日志中：正在上传到 {1}...", "{0} はすでにログにあります：{1} へアップロード中...")
        A("{0}: log completo -> subidos {1}, ya estaban {2}, errores {3}", "", "{0}: full log -> uploaded {1}, already there {2}, errors {3}", "{0}: vollständiges Log -> hochgeladen {1}, schon vorhanden {2}, Fehler {3}", "{0}: log completo -> enviados {1}, já estavam {2}, erros {3}", "{0}: весь журнал -> загружено {1}, уже было {2}, ошибок {3}", "{0}：完整日志 -> 已上传 {1}，已存在 {2}，错误 {3}", "{0}：ログ全体 -> アップロード {1}、既存 {2}、エラー {3}")
        A("{0}: pendientes -> subidos {1}, ya estaban {2}, siguen pendientes {3}", "", "{0}: pending -> uploaded {1}, already there {2}, still pending {3}", "{0}: ausstehend -> hochgeladen {1}, schon vorhanden {2}, noch ausstehend {3}", "{0}: pendentes -> enviados {1}, já estavam {2}, continuam pendentes {3}", "{0}: отложенные -> загружено {1}, уже было {2}, осталось {3}", "{0}：待传 -> 已上传 {1}，已存在 {2}，仍待传 {3}", "{0}：保留分 -> アップロード {1}、既存 {2}、残り {3}")
        A("{0}: probablemente mando RR73 y no lo copiaste. 'Log QSO' si quieres registrarlo.", "{0}: probablemente mandó RR73 y no lo copiaste. 'Log QSO' si quieres registrarlo.", "{0}: probably sent RR73 and you did not copy it. 'Log QSO' if you want to log it.", "{0}: hat wahrscheinlich RR73 gesendet und du hast es nicht empfangen. 'QSO loggen', um es zu speichern.", "{0}: provavelmente mandou RR73 e você não copiou. 'Log QSO' se quiser registrá-lo.", "{0}: вероятно, передал RR73, а вы не приняли. «Запись QSO», чтобы записать.", "{0}：可能已发送 RR73 但你未收到。如需记录请点" & ChrW(&H201C) & "记录 QSO" & ChrW(&H201D) & "。", "{0}：RR73 を送ったのに受信できなかった可能性があります。記録するには「QSO 記録」。")
    End Sub
