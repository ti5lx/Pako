Imports System.Globalization

' ======================================================================
' Idiomas de Pako: espanol, ingles, aleman, portugues, ruso, chino y japones.
' Tr("clave", args...) devuelve el texto en el idioma elegido.
' La clave es el texto en espanol sin acentos (o un nombre en MAYUSCULAS
' para los textos largos). Si falta una traduccion, se muestra la clave.
' ESTE ARCHIVO DEBE GUARDARSE EN UTF-8 (tiene chino, japones y ruso).
' ======================================================================
Public Module Idioma
    ' Orden de las columnas en la tabla
    Private ReadOnly Orden As String() = {"es", "en", "de", "pt", "ru", "zh", "ja"}

    ' Idiomas para el menu (cada uno escrito en su propio idioma)
    Public ReadOnly Disponibles As New List(Of KeyValuePair(Of String, String)) From {
        New KeyValuePair(Of String, String)("es", "Español"),
        New KeyValuePair(Of String, String)("en", "English"),
        New KeyValuePair(Of String, String)("de", "Deutsch"),
        New KeyValuePair(Of String, String)("pt", "Português"),
        New KeyValuePair(Of String, String)("ru", "Русский"),
        New KeyValuePair(Of String, String)("zh", "中文"),
        New KeyValuePair(Of String, String)("ja", "日本語")}

    Public Property Codigo As String = "es"

    Private tabla As Dictionary(Of String, String())

    ' Al arrancar: el idioma guardado, o el de Windows la primera vez (si no esta, ingles)
    Public Sub Iniciar()
        Dim c As String = ""
        Try
            c = GetSetting("Pako", "Opciones", "Idioma", "")
        Catch
        End Try
        If c = "" Then c = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName.ToLowerInvariant()
        If Array.IndexOf(Orden, c) < 0 Then c = "en"
        Codigo = c
    End Sub

    Public Sub Guardar(c As String)
        Try
            SaveSetting("Pako", "Opciones", "Idioma", c)
        Catch
        End Try
    End Sub

    ' Traducir (y, si hay argumentos, completar {0}, {1}...)
    Public Function Tr(clave As String, ParamArray args As Object()) As String
        Dim r As String = Buscar(Codigo, clave)
        If args IsNot Nothing AndAlso args.Length > 0 Then
            Try
                r = String.Format(r, args)
            Catch
            End Try
        End If
        Return r
    End Function

    ' Un texto en un idioma dado (para avisar en el idioma nuevo al cambiarlo)
    Public Function TrEn(c As String, clave As String) As String
        Return Buscar(c, clave)
    End Function

    Private Function Buscar(c As String, clave As String) As String
        If tabla Is Nothing Then Cargar()
        Dim fila As String() = Nothing
        If clave Is Nothing OrElse Not tabla.TryGetValue(clave, fila) Then Return clave
        Dim i As Integer = Array.IndexOf(Orden, c)
        If i < 0 Then i = 1
        Dim v As String = fila(i)
        If String.IsNullOrEmpty(v) Then v = fila(0)       ' sin traduccion: espanol
        If String.IsNullOrEmpty(v) Then v = clave         ' espanol igual a la clave
        Return v
    End Function

    Private Sub A(clave As String, es As String, en As String, de As String, pt As String, ru As String, zh As String, ja As String)
        tabla(clave) = New String() {es, en, de, pt, ru, zh, ja}
    End Sub

    Private Sub Cargar()
        tabla = New Dictionary(Of String, String())(StringComparer.Ordinal)
        Cargar1()
        Cargar2()
        Cargar3()
        Cargar4()
        Cargar5()
        Cargar6()
        Cargar7()
    End Sub

    Private Sub Cargar1()
        A("(mouse encima = explicacion)", "(mouse encima = explicación)", "(hover = explanation)", "(Maus darüber = Erklärung)", "(mouse em cima = explicação)", "(наведите мышь = пояснение)", "（鼠标悬停 = 说明）", "（マウスを重ねる = 説明）")
        A("ACERCA_TEXTO", "Programa FT8 / FT4 para radioafición." & vbCrLf & "«Pakö» significa «comunicar» en idioma bribri." & vbCrLf & "" & vbCrLf & "Programa escrito por {0}, Costa Rica." & vbCrLf & "" & vbCrLf & "USO LIBRE para fines de radioafición, sin fines de lucro." & vbCrLf & "Se puede usar, copiar y compartir gratuitamente entre" & vbCrLf & "radioaficionados. No se permite su venta ni su uso comercial." & vbCrLf & "" & vbCrLf & "Se entrega tal cual, sin garantía de ningún tipo." & vbCrLf & "" & vbCrLf & "Usa ft8_lib de Kārlis Goba (licencia MIT)" & vbCrLf & "y NAudio de Mark Heath (licencia MIT)." & vbCrLf & "Control del radio con Hamlib (licencia LGPL)." & vbCrLf & "" & vbCrLf & "73 de {0}", "FT8 / FT4 software for amateur radio." & vbCrLf & """Pakö"" means ""to communicate"" in the Bribri language." & vbCrLf & "" & vbCrLf & "Written by {0}, Costa Rica." & vbCrLf & "" & vbCrLf & "FREE TO USE for amateur radio, non-commercial purposes." & vbCrLf & "It may be used, copied and shared free of charge among" & vbCrLf & "radio amateurs. Selling it or commercial use is not allowed." & vbCrLf & "" & vbCrLf & "Provided as is, without warranty of any kind." & vbCrLf & "" & vbCrLf & "Uses ft8_lib by Kārlis Goba (MIT license)" & vbCrLf & "and NAudio by Mark Heath (MIT license)." & vbCrLf & "Radio control with Hamlib (LGPL license)." & vbCrLf & "" & vbCrLf & "73 de {0}", "FT8 / FT4 Programm für den Amateurfunk." & vbCrLf & "" & ChrW(&H201E) & "Pakö" & ChrW(&H201C) & " bedeutet " & ChrW(&H201E) & "kommunizieren" & ChrW(&H201C) & " in der Sprache Bribri." & vbCrLf & "" & vbCrLf & "Geschrieben von {0}, Costa Rica." & vbCrLf & "" & vbCrLf & "FREIE NUTZUNG für den Amateurfunk, nicht kommerziell." & vbCrLf & "Darf unter Funkamateuren kostenlos genutzt, kopiert und" & vbCrLf & "weitergegeben werden. Verkauf und kommerzielle Nutzung verboten." & vbCrLf & "" & vbCrLf & "Ohne jegliche Gewährleistung." & vbCrLf & "" & vbCrLf & "Verwendet ft8_lib von Kārlis Goba (MIT-Lizenz)" & vbCrLf & "und NAudio von Mark Heath (MIT-Lizenz)." & vbCrLf & "Funkgerätesteuerung mit Hamlib (LGPL-Lizenz)." & vbCrLf & "" & vbCrLf & "73 de {0}", "Programa FT8 / FT4 para radioamadorismo." & vbCrLf & """Pakö"" significa ""comunicar"" no idioma bribri." & vbCrLf & "" & vbCrLf & "Programa escrito por {0}, Costa Rica." & vbCrLf & "" & vbCrLf & "USO LIVRE para radioamadorismo, sem fins lucrativos." & vbCrLf & "Pode ser usado, copiado e compartilhado gratuitamente entre" & vbCrLf & "radioamadores. Não é permitida a venda nem o uso comercial." & vbCrLf & "" & vbCrLf & "Fornecido como está, sem garantia de nenhum tipo." & vbCrLf & "" & vbCrLf & "Usa ft8_lib de Kārlis Goba (licença MIT)" & vbCrLf & "e NAudio de Mark Heath (licença MIT)." & vbCrLf & "Controle do rádio com Hamlib (licença LGPL)." & vbCrLf & "" & vbCrLf & "73 de {0}", "Программа FT8 / FT4 для радиолюбителей." & vbCrLf & "«Pakö» означает «общаться» на языке брибри." & vbCrLf & "" & vbCrLf & "Автор программы: {0}, Коста-Рика." & vbCrLf & "" & vbCrLf & "СВОБОДНОЕ ИСПОЛЬЗОВАНИЕ в радиолюбительских целях," & vbCrLf & "без коммерческой выгоды. Можно бесплатно использовать," & vbCrLf & "копировать и передавать. Продажа и коммерческое" & vbCrLf & "использование запрещены." & vbCrLf & "" & vbCrLf & "Поставляется «как есть», без каких-либо гарантий." & vbCrLf & "" & vbCrLf & "Использует ft8_lib (Kārlis Goba, лицензия MIT)" & vbCrLf & "и NAudio (Mark Heath, лицензия MIT)." & vbCrLf & "Управление трансивером: Hamlib (лицензия LGPL)." & vbCrLf & "" & vbCrLf & "73 de {0}", "业余无线电 FT8 / FT4 软件。" & vbCrLf & "" & ChrW(&H201C) & "Pakö" & ChrW(&H201D) & "在布里布里语中意为" & ChrW(&H201C) & "交流" & ChrW(&H201D) & "。" & vbCrLf & "" & vbCrLf & "作者：{0}，哥斯达黎加。" & vbCrLf & "" & vbCrLf & "供业余无线电免费使用，非商业用途。" & vbCrLf & "可在业余无线电爱好者之间免费使用、复制和分享。" & vbCrLf & "禁止销售或商业使用。" & vbCrLf & "" & vbCrLf & "按原样提供，不提供任何形式的担保。" & vbCrLf & "" & vbCrLf & "使用 Kārlis Goba 的 ft8_lib（MIT 许可证）" & vbCrLf & "和 Mark Heath 的 NAudio（MIT 许可证）。" & vbCrLf & "电台控制使用 Hamlib（LG