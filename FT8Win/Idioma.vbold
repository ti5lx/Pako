    Private Sub Cargar3()
        A("PTT soltado", "", "PTT released", "PTT losgelassen", "PTT solto", "PTT отпущен", "PTT 已释放", "PTT 解除")
        A("Par (00/15/30/45)", "", "Even (00/15/30/45)", "Gerade (00/15/30/45)", "Par (00/15/30/45)", "Чётн. (00/15/30/45)", "偶数 (00/15/30/45)", "偶数 (00/15/30/45)")
        A("Par (00/30)", "", "Even (00/30)", "Gerade (00/30)", "Par (00/30)", "Чётн. (00/30)", "偶数 (00/30)", "偶数 (00/30)")
        A("Para subir a LoTW falta la Station Location (tal como se llama en TQSL).", "", "To upload to LoTW the Station Location is missing (as named in TQSL).", "Für LoTW fehlt die Station Location (wie in TQSL benannt).", "Para enviar ao LoTW falta a Station Location (como está no TQSL).", "Для загрузки в LoTW не указана Station Location (как в TQSL).", "上传到 LoTW 需要 Station Location（与 TQSL 中一致）。", "LoTW へのアップロードには Station Location（TQSL での名前）が必要です。")
        A("Para subir a LoTW selecciona el archivo tqsl.exe.", "", "To upload to LoTW, select the tqsl.exe file.", "Für LoTW wähle die Datei tqsl.exe.", "Para enviar ao LoTW, selecione o arquivo tqsl.exe.", "Для загрузки в LoTW выберите файл tqsl.exe.", "上传到 LoTW 请选择 tqsl.exe 文件。", "LoTW へのアップロードには tqsl.exe を選んでください。")
        A("Para subir a QRZ falta la API key.", "", "To upload to QRZ the API key is missing.", "Für QRZ fehlt der API-Schlüssel.", "Para enviar ao QRZ falta a chave API.", "Для загрузки в QRZ нужен API-ключ.", "上传到 QRZ 需要 API 密钥。", "QRZ へのアップロードには API キーが必要です。")
        A("Para subir a eQSL faltan el usuario o la contrasena.", "Para subir a eQSL faltan el usuario o la contraseña.", "To upload to eQSL the user name or password is missing.", "Für eQSL fehlen Benutzername oder Passwort.", "Para enviar ao eQSL faltam o usuário ou a senha.", "Для загрузки в eQSL нужны имя пользователя и пароль.", "上传到 eQSL 需要用户名和密码。", "eQSL へのアップロードにはユーザー名とパスワードが必要です。")
        A("Primero configura {0} en Configurar > Servicios de log.", "", "First set up {0} in Settings > Log services.", "Richte zuerst {0} unter Einstellungen > Log-Dienste ein.", "Primeiro configure {0} em Configurar > Serviços de log.", "Сначала настройте {0} в Настройки > Сервисы журнала.", "请先在 设置 > 日志服务 中配置 {0}。", "まず 設定 > ログサービス で {0} を設定してください。")
        A("Probar PTT", "", "Test PTT", "PTT testen", "Testar PTT", "Проверить PTT", "测试 PTT", "PTT テスト")
        A("Probar", "", "Test", "Testen", "Testar", "Проверить", "测试", "テスト")
        A("Programas", "", "Programs", "Programme", "Programas", "Программы", "程序", "プログラム")
        A("Proximo mensaje: {0}", "Próximo mensaje: {0}", "Next message: {0}", "Nächste Nachricht: {0}", "Próxima mensagem: {0}", "Следующее сообщение: {0}", "下一条消息：{0}", "次のメッセージ：{0}")
        A("Prueba de PTT terminada (maximo {0} s)", "Prueba de PTT terminada (máximo {0} s)", "PTT test finished (maximum {0} s)", "PTT-Test beendet (maximal {0} s)", "Teste de PTT terminado (máximo {0} s)", "Проверка PTT завершена (максимум {0} с)", "PTT 测试结束（最长 {0} 秒）", "PTT テスト終了（最大 {0} 秒）")
        A("Puerto CAT", "", "CAT port", "CAT-Port", "Porta CAT", "Порт CAT", "CAT 端口", "CAT ポート")
        A("Puerto PTT (RTS)", "", "PTT port (RTS)", "PTT-Port (RTS)", "Porta PTT (RTS)", "Порт PTT (RTS)", "PTT 端口（RTS）", "PTT ポート（RTS）")
        A("QRZ: {0} de {1}  (subidos {2}, duplicados {3}, errores {4})", "", "QRZ: {0} of {1}  (uploaded {2}, duplicates {3}, errors {4})", "QRZ: {0} von {1}  (hochgeladen {2}, Duplikate {3}, Fehler {4})", "QRZ: {0} de {1}  (enviados {2}, duplicados {3}, erros {4})", "QRZ: {0} из {1}  (загружено {2}, дубликатов {3}, ошибок {4})", "QRZ：{0}/{1}（已上传 {2}，重复 {3}，错误 {4}）", "QRZ：{0}/{1}（アップロード {2}、重複 {3}、エラー {4}）")
        A("QSO con {0} cancelado", "", "QSO with {0} cancelled", "QSO mit {0} abgebrochen", "QSO com {0} cancelado", "QSO с {0} отменено", "与 {0} 的通联已取消", "{0} との QSO を中止しました")
        A("QSO con {0} incompleto", "", "QSO with {0} incomplete", "QSO mit {0} unvollständig", "QSO com {0} incompleto", "QSO с {0} не завершено", "与 {0} 的通联未完成", "{0} との QSO は未完了")
        A("QSO con {0} registrado en el log", "", "QSO with {0} saved in the log", "QSO mit {0} im Log gespeichert", "QSO com {0} registrado no log", "QSO с {0} записано в журнал", "与 {0} 的通联已记入日志", "{0} との QSO をログに記録しました")
        A("QSO con {0} terminado", "", "QSO with {0} finished", "QSO mit {0} beendet", "QSO com {0} terminado", "QSO с {0} завершено", "与 {0} 的通联已完成", "{0} との QSO が終了")
