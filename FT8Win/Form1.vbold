Imports System.Drawing.Imaging
Imports System.Globalization
Imports System.IO
Imports System.IO.Ports
Imports System.Runtime.InteropServices
Imports System.Text.RegularExpressions
Imports System.Threading
Imports NAudio.Dsp
Imports NAudio.Wave
Imports NAudio.Wave.SampleProviders

Public Class Form1

    ' ==================================================================
    ' Controles que se crean por codigo (no hay que arrastrarlos)
    ' ==================================================================
    ' Fila 1: recepcion
    Private WithEvents btnEscuchar As New Button()
    Private barraNivel As New BarraNivel()
    Private lblReloj As New Label()               ' reloj UTC
    Private lblFrecRx As New Label()              ' frecuencia de RX (texto verde)
    Private WithEvents cascada As New Cascada()   ' waterfall
    Private frecRx As Single = 1500               ' frecuencia de RX (marca verde)

    ' --- Waterfall: FFT de 4096 puntos (2.9 Hz por bin), una linea cada 2048 muestras (0.17 s) ---
    Private Const FftN As Integer = 4096
    Private Const FftM As Integer = 12            ' 2^12 = 4096
    Private Const FftSalto As Integer = 2048
    Private bufferCascada As New List(Of Single)(FftN * 2)
    Private ventanaFft() As Single
    Private ultimoCicloCascada As Long = -1
    Private lblEstado As New Label()
    ' Fila 2: salida de audio, PTT, secuencia automatica
    ' Menu Configurar: entrada/salida de audio, puerto PTT y prueba de PTT
    Private menuPrincipal As New MenuStrip()
    Private mnuEntrada As New ToolStripMenuItem()
    Private mnuSalida As New ToolStripMenuItem()
    Private WithEvents mnuPuerto As New ToolStripMenuItem()
    Private WithEvents mnuProbarPtt As New ToolStripMenuItem()
    Private mnuPsk As New ToolStripMenuItem() With {.CheckOnClick = True}
    Private entradaSel As Integer = -1       ' dispositivo de entrada (RX)
    Private salidaSel As Integer = -1        ' dispositivo de salida (TX)
    Private puertoSel As String = ""         ' puerto COM del PTT
    Private pruebaPttActiva As Boolean = False
    Private inicioPruebaPtt As DateTime
    Private Const MaxPruebaPttSeg As Integer = 30   ' la prueba de PTT se suelta sola a los 30 s
    Private chkAutoSeq As New CheckBox()
    Private chkCola As New CheckBox()
    Private lblQso As New Label()
    ' Fila 3: estacion propia y mensaje a transmitir
    ' Mi estacion (se edita en Configurar > Mi estacion)
    Private miCallValor As String = "TI2LX"
    Private miGridValor As String = "EK70"
    Private WithEvents mnuEstacion As New ToolStripMenuItem()
    Private cmbBanda As New ComboBox()     ' frecuencias FT8 estandar
    Private txtDialOtra As New TextBox()   ' frecuencia a mano (si esta vacia se usa la del combo)
    Private WithEvents txtMensaje As New TextBox()
    Private numFrecTx As New NumericUpDown()
    Private chkPar As New CheckBox()
    Private WithEvents btnTx As New Button()
    ' Fila 4: botones CQ / Log QSO y estado de la transmision
    Private WithEvents btnCQ As New Button()
    Private WithEvents btnLog As New Button()
    Private WithEvents btnReset As New Button()
    Private WithEvents lnkPendientes As New LinkLabel()
    Private subiendoPendientes As Boolean = False
    Private proximoReintento As DateTime = DateTime.UtcNow.AddMinutes(1)   ' primer reintento al minuto de arrancar
    Private proximaRevision As DateTime = DateTime.MinValue
    Private Const MinutosReintento As Integer = 10
    Private WithEvents btnTune As New Button()
    Private WithEvents trkTx As New TrackBar()
    Private lblNivelTx As New Label()
    Private lblTx As New Label()
    ' Lista de mensajes
    Private WithEvents lstMensajes As New ListBox()
    Private lblColumnas As New Label()          ' encabezado: UTC dB DT Freq Mensaje
    Private ayudaLista As New ToolTip()         ' explicacion de la linea bajo el mouse
    Private indiceAyuda As Integer = -1
    ' Reloj que revisa cuando toca transmitir
    Private WithEvents tmrTx As New System.Windows.Forms.Timer()
    ' Guardado automatico: 1 s despues del ultimo cambio (asi no se guarda en cada tecla)
    Private WithEvents tmrGuardar As New System.Windows.Forms.Timer() With {.Interval = 1000}
    Private cargandoConfig As Boolean = False

    ' ==================================================================
    ' Recepcion
    ' ==================================================================
    Private Const SampleRate As Integer = 12000
    Private Const LatenciaAudio As Single = 0.2F    ' retardo de captura, calibrado contra WSJT-X
    ' --- Modo: FT8 (ciclos de 15 s) o FT4 (ciclos de 7.5 s) ---
    Private WithEvents cmbModo As New ComboBox()
    Private modoFT4 As Boolean = False

    ' --- JTTY: texto libre tipo RTTY, sin ciclos (motor de WSJT-X en jtty_pako.dll) ---
    Private modoJtty As Boolean = False
    Private jtty As JttyMotor
    Private ReadOnly jttyCandado As New Object()                    ' el motor no admite dos hilos a la vez
    Private ReadOnly jttyCola As New List(Of Short)(SampleRate)     ' audio capturado, pendiente de decodificar
    Private jttyHilo As Thread                                      ' hilo que decodifica (Nothing = detenido)
    Private jttyReiniciar As Boolean = False                        ' borrar el audio acumulado en el motor
    Private ReadOnly jttyLineas As New Dictionary(Of Long, Decodificado)   ' Id del mensaje -> su linea en la lista
    Private Const MaxLetrasJtty As Integer = 80
    Private Const AnchoJttyHz As Single = 94.0F                     ' 4 tonos separados 31.25 Hz
    Private lblMensaje As Label
    Private pnlMacros As New Panel()
    Private ReadOnly botonesMacro As New List(Of Button)

    Private ReadOnly Property Periodo As Double          ' duracion del ciclo en segundos
        Get
            Return If(modoFT4, 7.5, 15.0)
        End Get
    End Property

    Private ReadOnly Property ModoDll As Integer         ' 0 = FT8, 1 = FT4 (para FT8Core.dll)
        Get
            Return If(modoFT4, 1, 0)
        End Get
    End Property

    ' Se decodifica apenas termina la senal (FT8 a los 14 s, FT4 a los 6.3 s),
    ' asi hay tiempo de preparar la respuesta para el ciclo siguiente
    Private ReadOnly Property SegundoDecodificar As Double
        Get
            Return If(modoFT4, 6.3, 14.0)
        End Get
    End Property
    Private WithEvents waveIn As WaveInEvent

    Private bufferCiclo As New List(Of Single)(16 * SampleRate)
    Private cicloActual As Long = -1      ' numero de ciclo (de 15 o 7.5 s) desde 1970
    Private cicloIncompleto As Boolean = True
    Private yaDecodificado As Boolean = False
    Private picoNivel As Single = 0

    ' ==================================================================
    ' Transmision
    ' ==================================================================
    Private Const SampleRateTx As Integer = 48000   ' 48 kHz: lo acepta cualquier tarjeta de sonido
    Private Const LatenciaSalida As Double = 0.1    ' retardo de la salida de audio (s)
    Private Const MaxInicioTardeFT8 As Double = 1.5  ' segundos: se puede empezar a transmitir tarde
    Private Const MaxInicioTardeFT4 As Double = 0.6
    Private Const MaxTransmisiones As Integer = 12  ' vigilancia: se detiene sola despues de 12 ciclos (~6 min)

    ' Lo que se va a transmitir en el proximo ciclo (se lee justo antes de sonar)
    Private Class PlanTx
        Public Texto As String
        Public Audio As Byte()
        Public DetenerDespues As Boolean   ' ultimo mensaje del QSO (RR73 o 73)
        Public Desplazamiento As Integer   ' split Fake It: cuanto se mueve el VFO al transmitir (Hz)
    End Class

    Private puertoPtt As SerialPort
    Private planActual As PlanTx
    Private txArmado As Boolean = False             ' el usuario pidio transmitir
    Private txEnCurso As Boolean = False            ' hay una transmision sonando ahora
    Private cicloTx As Long = -1                    ' ciclo en que se esta transmitiendo (no se decodifica)
    Private dispositivoSalida As Integer = 0
    Private volumenTx As Single = 0.5F                   ' nivel de audio TX (0 a 1), del deslizador
    Private volumenEnCurso As VolumeSampleProvider       ' para cambiar el nivel mientras suena
    Private mostrandoTx As Boolean = False               ' la barra de nivel muestra TX en vez de RX
    Private transmisionesHechas As Integer = 0

    ' CAT (Hamlib)
    Private dialCatHz As Long = 0              ' frecuencia de dial del radio (sin el desplazamiento del split)
    Private vfoDesplazado As Boolean = False   ' el VFO esta movido por el split durante una transmision
    Private cambiandoDesdeCat As Boolean = False

    ' Tune: portadora continua en la frecuencia TX para ajustar potencia, ALC o el acoplador
    Private tuneActivo As Boolean = False
    Private tuneSalida As WaveOutEvent
    Private tuneGenerador As SignalGenerator
    Private inicioTune As DateTime
    Private Const MaxTuneSeg As Integer = 60     ' se apaga solo al minuto (proteccion del final)

    ' ==================================================================
    ' QSO en curso
    ' ==================================================================
    Private dxCall As String = ""          ' estacion con la que estamos haciendo el QSO
    Private dxGrid As String = ""
    Private reporteEnviado As String = ""  ' el que le damos (su SNR en nuestro receptor)
    Private reporteRecibido As String = "" ' el que nos da
    Private ultimoRegistrado As String = ""
    Private ultimoRegistroAdif As String = ""   ' el registro ADIF del ultimo QSO (para volver a subirlo)
    ' Cola: estaciones que nos llamaron mientras estabamos en otro QSO (indicativo -> ultimo mensaje)
    Private llamadores As New Dictionary(Of String, Decodificado)
    Private Const CiclosEnCola As Integer = 4   ' se olvidan despues de 4 ciclos (1 minuto)
    Private horaUltimoRegistro As DateTime = DateTime.MinValue

    Private Shared ReadOnly Epoca As New DateTime(1970, 1, 1, 0, 0, 0, DateTimeKind.Utc)

    ' Nombre del programa: Pako con dieresis en la o (se escribe con ChrW para que el archivo
    ' fuente no dependa de la codificacion)
    Public Shared ReadOnly NombrePrograma As String = "Pak" & ChrW(&HF6)
    Public Const VersionPrograma As String = "1.0"
    Public Const Autor As String = "TI2LX"
    Public Shared ReadOnly Property TituloPrograma As String
        Get
            Return NombrePrograma & " V." & VersionPrograma & "   " & Tr("El comunicador Bribri") & "   by " & Autor
        End Get
    End Property

    ' Icono de Pako (Proyecto > Propiedades > Recursos, con el nombre "Pako").
    ' Todas las ventanas lo usan: Me.Icon = Form1.IconoPako
    Private Shared _icono As Icon
    Public Shared ReadOnly Property IconoPako As Icon
        Get
            If _icono Is Nothing Then _icono = My.Resources.Pako
            Return _icono
        End Get
    End Property

    ' ==================================================================
    ' Armar la ventana
    ' ==================================================================
    Private Sub Form1_Load(sender As Object, e As EventArgs) Handles MyBase.Load
        Idioma.Iniciar()
        Me.Text = TituloPrograma
        Me.Icon = IconoPako
        Me.Font = New Font("Segoe UI", 9.0F)
        ' Tamano inicial (sin pasarse de la pantalla) y centrado
        Dim area As Rectangle = Screen.FromPoint(Cursor.Position).WorkingArea
        Me.Size = New Size(Math.Min(1180, area.Width), Math.Min(840, area.Height))
        Me.StartPosition = FormStartPosition.Manual
        Me.Location = New Point(area.Left + (area.Width - Me.Width) \ 2, area.Top + (area.Height - Me.Height) \ 2)
        Me.MinimumSize = New Size(1000, 680)

        ' Distribucion de la ventana:
        '   Menu Configurar
        '   Barra superior: recepcion (Escuchar, nivel, modo, banda, reloj UTC)
        '   Waterfall
        '   Abajo a la izquierda: mensajes      Abajo a la derecha: mi estacion / transmision / QSO

        ArmarMenu()

        ' ================= BARRA SUPERIOR: RECEPCION =================
        Dim pnlArriba As New Panel() With {.Dock = DockStyle.Top, .Height = 44}
        Me.Controls.Add(pnlArriba)   ' se agrega ya, para que herede la letra antes de medir etiquetas
        Dim x As Integer = 8
        Const yA As Integer = 10

        btnEscuchar.Text = Tr("Escuchar")
        btnEscuchar.Size = New Size(95, 27)
        btnEscuchar.Location = New Point(x, yA - 2)
        pnlArriba.Controls.Add(btnEscuchar)
        x = btnEscuchar.Right + 10

        barraNivel.Location = New Point(x, yA)
        barraNivel.Size = New Size(150, 22)
        pnlArriba.Controls.Add(barraNivel)
        x = barraNivel.Right + 22

        x = Etiqueta(pnlArriba, Tr("Modo"), x, yA + 3).Right + 4
        cmbModo.DropDownStyle = ComboBoxStyle.DropDownList
        cmbModo.Location = New Point(x, yA)
        cmbModo.Width = 64
        cmbModo.Items.AddRange(New Object() {"FT8", "FT4", "JTTY"})
        cmbModo.SelectedIndex = 0
        pnlArriba.Controls.Add(cmbModo)
        x = cmbModo.Right + 18

        x = Etiqueta(pnlArriba, Tr("Banda"), x, yA + 3).Right + 4
        cmbBanda.DropDownStyle = ComboBoxStyle.DropDownList
        cmbBanda.Location = New Point(x, yA)
        cmbBanda.Width = 115
        LlenarBandas()
        pnlArriba.Controls.Add(cmbBanda)
        x = cmbBanda.Right + 8

        x = Etiqueta(pnlArriba, Tr("u otra:"), x, yA + 3).Right + 2
        txtDialOtra.Location = New Point(x, yA)
        txtDialOtra.Width = 70
        pnlArriba.Controls.Add(txtDialOtra)
        Dim ayuda As New ToolTip()
        ayudaCat.SetToolTip(txtDialOtra, Tr("Otra frecuencia de dial en MHz (ej. 14.080). Si esta vacia se usa la de la lista."))
        x = Etiqueta(pnlArriba, "MHz", txtDialOtra.Right + 3, yA + 3).Right + 22

        lblEstado.AutoSize = True
        lblEstado.ForeColor = Color.DimGray
        lblEstado.Location = New Point(x, yA + 3)
        lblEstado.Text = Tr("Detenido")
        pnlArriba.Controls.Add(lblEstado)


        ' Reloj UTC grande a la derecha (FT8 depende de la hora exacta)
        lblReloj.AutoSize = False
        lblReloj.Size = New Size(150, 30)
        lblReloj.TextAlign = ContentAlignment.MiddleRight
        lblReloj.Font = New Font("Consolas", 14.0F, FontStyle.Bold)
        lblReloj.ForeColor = Color.SteelBlue
        lblReloj.Anchor = AnchorStyles.Top Or AnchorStyles.Right
        lblReloj.Location = New Point(pnlArriba.Width - 10 - lblReloj.Width, yA - 4)

        ' Aviso de QSOs sin subir (clic = subirlos ya)
        lnkPendientes.AutoSize = False
        lnkPendientes.Size = New Size(200, 20)
        lnkPendientes.TextAlign = ContentAlignment.MiddleRight
        lnkPendientes.Anchor = AnchorStyles.Top Or AnchorStyles.Right
        lnkPendientes.Location = New Point(lblReloj.Left - 205, yA + 1)
        lnkPendientes.Font = New Font(Me.Font, FontStyle.Bold)
        lnkPendientes.LinkColor = Color.DarkOrange
        lnkPendientes.ActiveLinkColor = Color.OrangeRed
        lnkPendientes.LinkBehavior = LinkBehavior.HoverUnderline
        lnkPendientes.Visible = False
        pnlArriba.Controls.Add(lnkPendientes)
        Dim ayudaPend As New ToolTip()
        ayudaPend.SetToolTip(lnkPendientes, Tr("Clic para subirlos ahora. Pako los reintenta solo cada 10 minutos."))
        pnlArriba.Controls.Add(lblReloj)

        ' ================= WATERFALL =================
        ' (clic izquierdo = RX, clic derecho = TX)
        cascada.Dock = DockStyle.Top
        cascada.Height = 190
        cascada.FrecTx = CSng(numFrecTx.Value)
        Me.Controls.Add(cascada)
        AddHandler numFrecTx.ValueChanged, Sub() cascada.FrecTx = CSng(numFrecTx.Value)
        ReDim ventanaFft(FftN - 1)
        For i As Integer = 0 To FftN - 1
            ventanaFft(i) = CSng(0.5 - 0.5 * Math.Cos(2 * Math.PI * i / (FftN - 1)))  ' ventana de Hann
        Next
        Dim separador As New Panel() With {.Dock = DockStyle.Top, .Height = 8}
        Me.Controls.Add(separador)

        ' ================= PANEL DERECHO =================
        Dim pnlDerecho As New Panel() With {.Dock = DockStyle.Right, .Width = 322}
        Me.Controls.Add(pnlDerecho)
        Const ancho As Integer = 300          ' ancho util de los grupos
        Const xg As Integer = 10              ' margen izquierdo dentro de cada grupo

        ' --- Transmision ---
        Dim grpTx As New GroupBox() With {.Text = Tr("Transmision"), .Location = New Point(10, 0), .Size = New Size(ancho, 232)}
        pnlDerecho.Controls.Add(grpTx)
        lblMensaje = Etiqueta(grpTx, Tr("Mensaje (Enter = cambiarlo)"), xg, 20)
        txtMensaje.Location = New Point(xg, 38)
        txtMensaje.Width = ancho - 2 * xg
        txtMensaje.CharacterCasing = CharacterCasing.Upper
        txtMensaje.Font = New Font("Consolas", 10.0F)
        txtMensaje.Text = "CQ TI2LX EK70"
        grpTx.Controls.Add(txtMensaje)

        Etiqueta(grpTx, "TX", xg, 72)
        numFrecTx.Location = New Point(xg + 24, 69)
        numFrecTx.Width = 62
        numFrecTx.Minimum = 200
        numFrecTx.Maximum = 2900
        numFrecTx.Increment = 10
        numFrecTx.Value = 1500
        grpTx.Controls.Add(numFrecTx)
        Etiqueta(grpTx, "Hz", numFrecTx.Right + 3, 72)
        Dim lblRx As Label = Etiqueta(grpTx, "RX", numFrecTx.Right + 30, 72)
        lblFrecRx.AutoSize = True
        lblFrecRx.ForeColor = Color.ForestGreen
        lblFrecRx.Font = New Font(Me.Font, FontStyle.Bold)
        lblFrecRx.Location = New Point(lblRx.Right + 4, 72)
        lblFrecRx.Text = "1500 Hz"
        grpTx.Controls.Add(lblFrecRx)

        chkPar.Text = Tr("Par (00/30)")
        chkPar.AutoSize = False
        chkPar.Width = 140
        chkPar.Checked = True
        chkPar.Location = New Point(xg, 100)
        grpTx.Controls.Add(chkPar)

        btnTune.Text = "Tune"
        btnTune.Location = New Point(xg + 150, 97)
        btnTune.Size = New Size(ancho - 2 * xg - 150, 26)
        grpTx.Controls.Add(btnTune)
        Dim ayudaTune As New ToolTip()
        ayudaTune.SetToolTip(btnTune, Tr("Transmite un tono continuo en la frecuencia TX para ajustar la potencia, el ALC o el acoplador de antena. Clic otra vez para detenerlo (se apaga solo a los {0} s).", MaxTuneSeg))

        btnTx.Text = Tr("Transmitir")
        btnTx.Font = New Font(Me.Font.FontFamily, 11.0F, FontStyle.Bold)
        btnTx.Location = New Point(xg, 128)
        btnTx.Size = New Size(ancho - 2 * xg, 36)
        grpTx.Controls.Add(btnTx)

        btnCQ.Text = Tr("Llamar CQ")
        btnCQ.Location = New Point(xg, 170)
        btnCQ.Size = New Size((ancho - 2 * xg - 12) \ 3, 26)
        grpTx.Controls.Add(btnCQ)

        btnLog.Text = Tr("Log QSO")
        btnLog.Location = New Point(btnCQ.Right + 6, 170)
        btnLog.Size = btnCQ.Size
        grpTx.Controls.Add(btnLog)

        btnReset.Text = Tr("Reset QSO")
        btnReset.Location = New Point(btnLog.Right + 6, 170)
        btnReset.Size = btnCQ.Size
        grpTx.Controls.Add(btnReset)
        Dim ayudaReset As New ToolTip()
        ayudaReset.SetToolTip(btnReset, Tr("Abandona el QSO actual, deja de transmitir y pone tu CQ en el mensaje (sin transmitir: presiona Transmitir o Llamar CQ cuando quieras)."))

        Etiqueta(grpTx, Tr("Nivel"), xg, 206)
        trkTx.AutoSize = False
        trkTx.Location = New Point(xg + 36, 202)
        trkTx.Size = New Size(150, 24)
        trkTx.Minimum = 0
        trkTx.Maximum = 100
        trkTx.TickStyle = TickStyle.None
        trkTx.Value = 50
        grpTx.Controls.Add(trkTx)
        lblNivelTx.AutoSize = True
        lblNivelTx.Location = New Point(trkTx.Right + 2, 206)
        grpTx.Controls.Add(lblNivelTx)
        ActualizarNivelTx()

        ' --- QSO ---
        Dim grpQso As New GroupBox() With {.Text = "QSO", .Location = New Point(10, grpTx.Bottom + 8), .Size = New Size(ancho, 160)}
        pnlDerecho.Controls.Add(grpQso)
        lblQso.AutoSize = False
        lblQso.Location = New Point(xg, 20)
        lblQso.Size = New Size(ancho - 2 * xg, 40)
        lblQso.Font = New Font(Me.Font.FontFamily, 10.0F, FontStyle.Bold)
        lblQso.ForeColor = Color.DarkRed
        lblQso.Text = ""
        grpQso.Controls.Add(lblQso)

        chkAutoSeq.Text = "Auto Seq"
        chkAutoSeq.AutoSize = True
        chkAutoSeq.Checked = True
        chkAutoSeq.Location = New Point(xg, 62)
        grpQso.Controls.Add(chkAutoSeq)

        chkCola.Text = Tr("Seguir con cola")
        chkCola.AutoSize = True
        chkCola.Checked = False
        chkCola.Location = New Point(xg + 110, 62)
        grpQso.Controls.Add(chkCola)
        Dim ayudaCola As New ToolTip()
        ayudaCola.SetToolTip(chkCola, Tr("Al terminar un QSO: contestar a la siguiente estacion que te llamo, o volver a llamar CQ si nadie espera."))

        ' Macros de JTTY (F1 a F4): ocupan el lugar de Auto Seq / cola, que en JTTY no se usan
        pnlMacros.Location = New Point(xg, 58)
        pnlMacros.Size = New Size(ancho - 2 * xg, 28)
        pnlMacros.Visible = False
        grpQso.Controls.Add(pnlMacros)
        Dim ayudaMacro As New ToolTip()
        Dim anchoMacro As Integer = (pnlMacros.Width - 9) \ 4
        For numMacro As Integer = 0 To 3
            Dim btnMacro As New Button() With {.Text = "F" & (numMacro + 1) & " " & NombresMacro(numMacro), .Tag = numMacro,
                                               .Location = New Point(numMacro * (anchoMacro + 3), 0), .Size = New Size(anchoMacro, 26)}
            AddHandler btnMacro.Click, AddressOf Macro_Click
            ayudaMacro.SetToolTip(btnMacro, Tr("Clic o tecla F{0}: transmite este mensaje al momento.", numMacro + 1))
            pnlMacros.Controls.Add(btnMacro)
            botonesMacro.Add(btnMacro)
        Next
        Me.KeyPreview = True          ' para que F1 a F4 funcionen desde cualquier control

        lblTx.AutoSize = False
        lblTx.Location = New Point(xg, 90)
        lblTx.Size = New Size(ancho - 2 * xg, 62)
        lblTx.Text = Tr("Doble clic en un mensaje para contestar.")
        grpQso.Controls.Add(lblTx)

        ' Ayuda de colores
        Dim lblAyuda As New Label() With {
            .AutoSize = False, .Location = New Point(10, grpQso.Bottom + 8), .Size = New Size(ancho, 130),
            .ForeColor = Color.DimGray,
            .Text = Tr("AYUDA_COLORES")}
        pnlDerecho.Controls.Add(lblAyuda)

        ' ================= LISTA DE MENSAJES =================
        Dim pnlLista As New Panel() With {.Dock = DockStyle.Fill, .Padding = New Padding(8, 0, 0, 8)}
        lstMensajes.Font = New Font("Consolas", 10)
        lstMensajes.DrawMode = DrawMode.OwnerDrawFixed
        lstMensajes.ItemHeight = 18
        lstMensajes.IntegralHeight = False
        lstMensajes.Dock = DockStyle.Fill
        pnlLista.Controls.Add(lstMensajes)

        ' Encabezado de columnas (mismo ancho de letra que la lista, para que calce)
        lblColumnas.Font = New Font("Consolas", 10)
        lblColumnas.BackColor = Color.SteelBlue
        lblColumnas.ForeColor = Color.White
        lblColumnas.AutoSize = False
        lblColumnas.Dock = DockStyle.Top
        lblColumnas.Height = 22
        lblColumnas.Padding = New Padding(3, 3, 0, 0)
        lblColumnas.Text = String.Format("{0,-6} {1,4} {2,5} {3,5}  {4}", "UTC", "dB", "DT", "Freq", Tr("Mensaje")) &
                           "     " & Tr("(mouse encima = explicacion)")
        pnlLista.Controls.Add(lblColumnas)
        lstMensajes.BringToFront()   ' la lista ocupa el espacio que deja el encabezado
        Me.Controls.Add(pnlLista)

        ayudaLista.InitialDelay = 400
        ayudaLista.AutoPopDelay = 30000
        ayudaLista.ReshowDelay = 200

        ' Clic derecho sobre la lista: borrar
        Dim menu As New ContextMenuStrip()
        menu.Items.Add(Tr("Borrar todo"), Nothing, Sub() lstMensajes.Items.Clear())
        menu.Items.Add(Tr("Borrar lo seleccionado"), Nothing,
                       Sub()
                           If lstMensajes.SelectedIndex >= 0 Then lstMensajes.Items.RemoveAt(lstMensajes.SelectedIndex)
                       End Sub)
        lstMensajes.ContextMenuStrip = menu

        ' Orden de acomodo (Dock): primero el menu arriba, luego la barra, el waterfall,
        ' el separador, el panel derecho, y la lista llena lo que sobra
        separador.SendToBack()
        cascada.SendToBack()
        pnlArriba.SendToBack()
        menuPrincipal.SendToBack()
        pnlDerecho.BringToFront()
        pnlLista.BringToFront()

        tmrTx.Interval = 100
        tmrTx.Start()

        CargarConfiguracion()
        CargarColores()
        AddHandler Cat.FrecuenciaCambio, AddressOf Cat_FrecuenciaCambio
        AddHandler Cat.Desconectado, AddressOf Cat_Desconectado
        AddHandler cmbBanda.SelectedIndexChanged, AddressOf BandaElegida
        ConectarCat()

        ' Cualquier cambio en estos controles se guarda solo (1 s despues)
        AddHandler txtDialOtra.TextChanged, AddressOf CambioConfig
        AddHandler cmbModo.SelectedIndexChanged, AddressOf CambioConfig
        AddHandler cmbBanda.SelectedIndexChanged, AddressOf CambioConfig
        AddHandler numFrecTx.ValueChanged, AddressOf CambioConfig
        AddHandler trkTx.ValueChanged, AddressOf CambioConfig
        AddHandler chkPar.CheckedChanged, AddressOf CambioConfig
        AddHandler chkAutoSeq.CheckedChanged, AddressOf CambioConfig
        AddHandler chkCola.CheckedChanged, AddressOf CambioConfig
    End Sub

    ' Algo de la configuracion cambio: programar el guardado
    Private Sub CambioConfig(sender As Object, e As EventArgs)
        If cargandoConfig Then Return
        tmrGuardar.Stop()
        tmrGuardar.Start()
    End Sub

    Private Sub tmrGuardar_Tick(sender As Object, e As EventArgs) Handles tmrGuardar.Tick
        tmrGuardar.Stop()
        GuardarConfiguracion()
    End Sub

    ' Crea una etiqueta de texto dentro de un contenedor
    Private Function Etiqueta(contenedor As Control, texto As String, x As Integer, y As Integer) As Label
        Dim l As New Label() With {.Text = texto, .AutoSize = True, .Location = New Point(x, y)}
        contenedor.Controls.Add(l)
        Return l
    End Function

    Private Sub Form1_FormClosing(sender As Object, e As FormClosingEventArgs) Handles Me.FormClosing
        GuardarConfiguracion()
        DetenerTune("")
        Cat.Desconectar()
        txArmado = False
        tmrTx.Stop()
        jttyHilo = Nothing
        DetenerCaptura()
        CerrarPuertoPtt()
    End Sub

    ' ==================================================================
    ' CONFIGURACION GUARDADA (My.Settings, en las propiedades del proyecto)
    ' ==================================================================
    Private Sub CargarConfiguracion()
        cargandoConfig = True
        Try
            With My.Settings
                If .MiIndicativo <> "" Then miCallValor = .MiIndicativo.Trim().ToUpper()
                If .MiGrid <> "" Then miGridValor = .MiGrid.Trim().ToUpper()
                ActualizarEstacion()
                txtMensaje.Text = "CQ " & miCallValor & " " & miGridValor

                ' Audio y puerto: se guardan por NOMBRE (los numeros pueden cambiar al conectar otro equipo)
                Dim i As Integer = BuscarPorNombre(WaveInEvent.DeviceCount, Function(k) WaveInEvent.GetCapabilities(k).ProductName, .EntradaAudio)
                If i >= 0 Then entradaSel = i
                i = BuscarPorNombre(WaveOut.DeviceCount, Function(k) WaveOut.GetCapabilities(k).ProductName, .SalidaAudio)
                If i >= 0 Then salidaSel = i
                If .PuertoPtt <> "" AndAlso PuertosOrdenados().Contains(.PuertoPtt) Then puertoSel = .PuertoPtt
                LlenarMenuEntrada()
                LlenarMenuSalida()
                LlenarMenuPuertos()

                ' Modo (esto recarga la lista de bandas) y banda
                cmbModo.SelectedIndex = If(.Modo = "FT4", 1, If(.Modo = "JTTY", 2, 0))
                For k As Integer = 0 To cmbBanda.Items.Count - 1
                    If cmbBanda.Items(k).ToString().Split(" "c)(0) = .Banda Then cmbBanda.SelectedIndex = k : Exit For
                Next
                txtDialOtra.Text = .DialManual

                ' Frecuencias, nivel TX y opciones
                numFrecTx.Value = Math.Max(numFrecTx.Minimum, Math.Min(numFrecTx.Maximum, CDec(.FrecTx)))
                cascada.FrecTx = CSng(numFrecTx.Value)
                PonerFrecRx(.FrecRx)
                trkTx.Value = Math.Max(trkTx.Minimum, Math.Min(trkTx.Maximum, .NivelTx))
                ActualizarNivelTx()
                chkPar.Checked = .CicloPar
                chkAutoSeq.Checked = .AutoSeq
                chkCola.Checked = .SeguirCola
                mnuPsk.Checked = .PskReporter
            End With
        Catch ex As Exception
            MessageBox.Show(Tr("No se pudo leer la configuracion guardada: {0}", ex.Message))
        Finally
            cargandoConfig = False
        End Try
    End Sub

    Private Sub GuardarConfiguracion()
        Try
            With My.Settings
                .MiIndicativo = MiCall
                .MiGrid = MiGrid
                .EntradaAudio = If(entradaSel >= 0, WaveInEvent.GetCapabilities(entradaSel).ProductName, "")
                .SalidaAudio = If(salidaSel >= 0, WaveOut.GetCapabilities(salidaSel).ProductName, "")
                .PuertoPtt = puertoSel
                .Modo = If(modoJtty, "JTTY", If(modoFT4, "FT4", "FT8"))
                .Banda = If(cmbBanda.SelectedItem Is Nothing, "", cmbBanda.SelectedItem.ToString().Split(" "c)(0))
                .DialManual = txtDialOtra.Text.Trim()
                .FrecTx = CInt(numFrecTx.Value)
                .FrecRx = CInt(frecRx)
                .NivelTx = trkTx.Value
                .CicloPar = chkPar.Checked
                .AutoSeq = chkAutoSeq.Checked
                .SeguirCola = chkCola.Checked
                .PskReporter = mnuPsk.Checked
                .Save()
            End With
        Catch
            ' Si no se puede guardar, no es grave: se usan los valores por defecto la proxima vez
        End Try
    End Sub

    Private Shared Function BuscarPorNombre(cantidad As Integer, nombre As Func(Of Integer, String), buscado As String) As Integer
        If String.IsNullOrEmpty(buscado) Then Return -1
        For k As Integer = 0 To cantidad - 1
            If nombre(k) = buscado Then Return k
        Next
        Return -1
    End Function

    ' ==================================================================
    ' MENU CONFIGURAR
    ' ==================================================================
    Private Sub ArmarMenu()
        Dim mnuConfigurar As New ToolStripMenuItem(Tr("Configurar"))
        mnuProbarPtt.Text = Tr("Probar PTT")
        mnuConfigurar.DropDownItems.Add(mnuEstacion)
        mnuConfigurar.DropDownItems.Add(New ToolStripSeparator())
        ActualizarEstacion()
        mnuConfigurar.DropDownItems.Add(mnuEntrada)
        mnuConfigurar.DropDownItems.Add(mnuSalida)
        mnuConfigurar.DropDownItems.Add(mnuPuerto)
        mnuConfigurar.DropDownItems.Add(New ToolStripSeparator())
        mnuConfigurar.DropDownItems.Add(mnuProbarPtt)
        mnuConfigurar.DropDownItems.Add(New ToolStripSeparator())
        mnuConfigurar.DropDownItems.Add(Tr("Radio (CAT)..."), Nothing,
            Sub()
                Cat.Desconectar()          ' liberar el puerto mientras se configura
                Using f As New FrmCat()
                    f.ShowDialog(Me)
                End Using
                ConectarCat()
            End Sub)
        mnuConfigurar.DropDownItems.Add(mnuPsk)
        mnuPsk.Text = Tr("Reportar a PSKReporter")
        mnuPsk.CheckOnClick = True
        mnuPsk.ToolTipText = Tr("Envia a pskreporter.info las estaciones que Pako escucha (cada 5 minutos). Aparecen en el mapa de PSKReporter como escuchadas por tu indicativo.")
        AddHandler mnuPsk.CheckedChanged, AddressOf CambioConfig
        mnuConfigurar.DropDownItems.Add(Tr("Servicios de log (QRZ, eQSL, LoTW)..."), Nothing,
            Sub()
                Dim antes = ServiciosListos()
                Using f As New FrmServicios(MiCall)
                    If f.ShowDialog(Me) <> DialogResult.OK Then Return
                End Using
                ' Si se acaba de activar un servicio, ofrecer subir los QSOs que ya estan en el log
                For Each servicio In ServiciosListos().Except(antes)
                    SubirLogCompleto(servicio)     ' pregunta antes de enviar
                Next
            End Sub)
        menuPrincipal.Items.Add(mnuConfigurar)

        ' --- Menu Log ---
        Dim mnuLog As New ToolStripMenuItem("Log")
        mnuLog.DropDownItems.Add(Tr("Ver trafico con los servidores..."), Nothing, Sub() MostrarTrafico())
        mnuLog.DropDownItems.Add(New ToolStripSeparator())
        Dim mnuPendientes As New ToolStripMenuItem(Tr("Subir pendientes"))
        AddHandler mnuPendientes.Click, Sub() SubirPendientes()
        mnuLog.DropDownItems.Add(mnuPendientes)
        mnuLog.DropDownItems.Add(New ToolStripSeparator())
        mnuLog.DropDownItems.Add(Tr("Subir log completo a {0}", "QRZ.com"), Nothing, Sub() SubirLogCompleto("QRZ"))
        mnuLog.DropDownItems.Add(Tr("Subir log completo a {0}", "eQSL"), Nothing, Sub() SubirLogCompleto("eQSL"))
        mnuLog.DropDownItems.Add(Tr("Subir log completo a {0}", "LoTW"), Nothing, Sub() SubirLogCompleto("LoTW"))
        mnuLog.DropDownItems.Add(New ToolStripSeparator())
        mnuLog.DropDownItems.Add(Tr("Log adicional para colores (ya trabajados)..."), Nothing,
            Sub()
                Using dlg As New OpenFileDialog()
                    dlg.Title = Tr("Elige tu log completo (ADIF) para marcar lo ya trabajado")
                    dlg.Filter = "Log ADIF (*.adi;*.adif)|*.adi;*.adif|" & Tr("Todos") & " (*.*)|*.*"
                    If dlg.ShowDialog(Me) = DialogResult.OK Then
                        My.Settings.LogColores = dlg.FileName
                        My.Settings.Save()
                        CargarColores()
                    End If
                End Using
            End Sub)
        mnuLog.DropDownItems.Add(Tr("Recargar cty.dat y logs"), Nothing, Sub() CargarColores())
        mnuLog.DropDownItems.Add(New ToolStripSeparator())
        mnuLog.DropDownItems.Add(Tr("Abrir carpeta del log"), Nothing,
            Sub()
                Dim ruta As String = RutaLog()
                If File.Exists(ruta) Then
                    Process.Start("explorer.exe", "/select,""" & ruta & """")
                Else
                    Process.Start("explorer.exe", """" & Path.GetDirectoryName(ruta) & """")
                End If
            End Sub)
        ' Al abrir el menu, mostrar cuantos pendientes hay
        AddHandler mnuLog.DropDownOpening,
            Sub()
                Dim n As Integer = 0
                For Each sv In Servicios
                    n += ColaPendientes.Cantidad(sv)
                Next
                mnuPendientes.Text = Tr("Subir pendientes") & If(n > 0, "  (" & n & ")", "  (" & Tr("ninguno") & ")")
                mnuPendientes.Enabled = n > 0
            End Sub
        menuPrincipal.Items.Add(mnuLog)

        ' --- Menu Acerca de ---
        Dim mnuAcerca As New ToolStripMenuItem(Tr("Acerca de"))
        AddHandler mnuAcerca.Click,
            Sub()
                Using f As New FrmAcercaDe()
                    f.ShowDialog(Me)
                End Using
            End Sub
        menuPrincipal.Items.Add(mnuAcerca)

        ' --- Menu Idioma (se aplica al reiniciar Pako) ---
        Dim mnuIdioma As New ToolStripMenuItem(Tr("Idioma"))
        For Each par In Idioma.Disponibles
            Dim codigo As String = par.Key
            Dim item As New ToolStripMenuItem(par.Value) With {.Checked = (codigo = Idioma.Codigo)}
            AddHandler item.Click,
                Sub()
                    If codigo = Idioma.Codigo Then Return
                    Idioma.Guardar(codigo)
                    If MessageBox.Show(Idioma.TrEn(codigo, "REINICIAR_IDIOMA"), NombrePrograma,
                                       MessageBoxButtons.YesNo, MessageBoxIcon.Question) = DialogResult.Yes Then
                        Application.Restart()
                    End If
                End Sub
            mnuIdioma.DropDownItems.Add(item)
        Next
        menuPrincipal.Items.Add(mnuIdioma)
        Me.MainMenuStrip = menuPrincipal
        Me.Controls.Add(menuPrincipal)

        ' Por defecto se prefiere el audio USB (el del radio)
        entradaSel = ElegirPorDefecto(WaveInEvent.DeviceCount, Function(i) WaveInEvent.GetCapabilities(i).ProductName)
        salidaSel = ElegirPorDefecto(WaveOut.DeviceCount, Function(i) WaveOut.GetCapabilities(i).ProductName)
        Dim puertos = PuertosOrdenados()
        If puertos.Length > 0 Then puertoSel = puertos(0)

        LlenarMenuEntrada()
        LlenarMenuSalida()
        LlenarMenuPuertos()
    End Sub

    ' Muestra la estacion en el menu y en el titulo de la ventana
    Private Sub ActualizarEstacion()
        PskReporter.MiIndicativo = miCallValor
        PskReporter.MiGrid = miGridValor
        PskReporter.Software = "Pako " & VersionPrograma
        mnuEstacion.Text = Tr("Mi estacion") & ":  " & miCallValor & "  (" & miGridValor & ")..."
        Me.Text = TituloPrograma
    End Sub

    ' Configurar > Mi estacion: ventanita para indicativo y grid
    Private Sub mnuEstacion_Click(sender As Object, e As EventArgs) Handles mnuEstacion.Click
        Using dlg As New Form()
            dlg.Text = Tr("Mi estacion")
            dlg.Icon = IconoPako
            dlg.Font = Me.Font
            dlg.FormBorderStyle = FormBorderStyle.FixedDialog
            dlg.StartPosition = FormStartPosition.CenterParent
            dlg.MinimizeBox = False
            dlg.MaximizeBox = False
            dlg.ClientSize = New Size(270, 130)

            Etiqueta(dlg, Tr("Indicativo"), 15, 20)
            Dim txtCall As New TextBox() With {.Location = New Point(95, 17), .Width = 150,
                                               .CharacterCasing = CharacterCasing.Upper, .Text = miCallValor}
            dlg.Controls.Add(txtCall)
            Etiqueta(dlg, Tr("Grid (4 car.)"), 15, 52)
            Dim txtGrid As New TextBox() With {.Location = New Point(95, 49), .Width = 70, .MaxLength = 4,
                                               .CharacterCasing = CharacterCasing.Upper, .Text = miGridValor}
            dlg.Controls.Add(txtGrid)

            Dim btnOk As New Button() With {.Text = Tr("Aceptar"), .Location = New Point(95, 90), .Size = New Size(75, 27)}
            Dim btnCancelar As New Button() With {.Text = Tr("Cancelar"), .Location = New Point(175, 90), .Size = New Size(75, 27),
                                                  .DialogResult = DialogResult.Cancel}
            dlg.Controls.Add(btnOk)
            dlg.Controls.Add(btnCancelar)
            dlg.AcceptButton = btnOk
            dlg.CancelButton = btnCancelar

            AddHandler btnOk.Click,
                Sub()
                    Dim c As String = txtCall.Text.Trim().ToUpper()
                    Dim g As String = txtGrid.Text.Trim().ToUpper()
                    If c.Length < 3 OrElse c.Contains(" ") Then
                        MessageBox.Show(dlg, Tr("Escribe un indicativo valido."))
                        Return
                    End If
                    If Not EsGrid(g) Then
                        MessageBox.Show(dlg, Tr("El grid debe tener 4 caracteres, por ejemplo EK70."))
                        Return
                    End If
                    dlg.DialogResult = DialogResult.OK
                End Sub

            If dlg.ShowDialog(Me) <> DialogResult.OK Then Return

            Dim anterior As String = "CQ " & miCallValor & " " & miGridValor
            miCallValor = txtCall.Text.Trim().ToUpper()
            miGridValor = txtGrid.Text.Trim().ToUpper()
            ActualizarEstacion()
            ' Si el mensaje era el CQ con los datos viejos, actualizarlo
            If txtMensaje.Text.Trim().ToUpper() = anterior Then txtMensaje.Text = "CQ " & miCallValor & " " & miGridValor
            GuardarConfiguracion()
        End Using
    End Sub

    Private Shared Function ElegirPorDefecto(cantidad As Integer, nombre As Func(Of Integer, String)) As Integer
        For i As Integer = 0 To cantidad - 1
            If nombre(i).ToUpper().Contains("USB") Then Return i
        Next
        Return If(cantidad > 0, 0, -1)
    End Function

    Private Shared Function PuertosOrdenados() As String()
        Return SerialPort.GetPortNames().OrderBy(Function(p) p.Length).ThenBy(Function(p) p).ToArray()
    End Function

    Private Sub LlenarMenuEntrada()
        mnuEntrada.DropDownItems.Clear()
        Dim nombreSel As String = "(" & Tr("ninguna") & ")"
        For i As Integer = 0 To WaveInEvent.DeviceCount - 1
            Dim nombre As String = WaveInEvent.GetCapabilities(i).ProductName
            Dim item As New ToolStripMenuItem(nombre) With {.Tag = i, .Checked = (i = entradaSel)}
            AddHandler item.Click, AddressOf ElegirEntrada_Click
            mnuEntrada.DropDownItems.Add(item)
            If i = entradaSel Then nombreSel = nombre
        Next
        mnuEntrada.Text = Tr("Entrada de audio (RX)") & ":  " & nombreSel
    End Sub

    Private Sub LlenarMenuSalida()
        mnuSalida.DropDownItems.Clear()
        Dim nombreSel As String = "(" & Tr("ninguna") & ")"
        For i As Integer = 0 To WaveOut.DeviceCount - 1
            Dim nombre As String = WaveOut.GetCapabilities(i).ProductName
            Dim item As New ToolStripMenuItem(nombre) With {.Tag = i, .Checked = (i = salidaSel)}
            AddHandler item.Click, AddressOf ElegirSalida_Click
            mnuSalida.DropDownItems.Add(item)
            If i = salidaSel Then nombreSel = nombre
        Next
        mnuSalida.Text = Tr("Salida de audio (TX)") & ":  " & nombreSel
    End Sub

    Private Sub LlenarMenuPuertos()
        mnuPuerto.DropDownItems.Clear()
        For Each p In PuertosOrdenados()
            Dim item As New ToolStripMenuItem(p) With {.Tag = p, .Checked = (p = puertoSel)}
            AddHandler item.Click, AddressOf ElegirPuerto_Click
            mnuPuerto.DropDownItems.Add(item)
        Next
        If mnuPuerto.DropDownItems.Count = 0 Then
            mnuPuerto.DropDownItems.Add(New ToolStripMenuItem("(" & Tr("no hay puertos COM") & ")") With {.Enabled = False})
        End If
        mnuPuerto.Text = Tr("Puerto PTT (RTS)") & ":  " & If(puertoSel = "", "(" & Tr("ninguno") & ")", puertoSel)
    End Sub

    ' Al abrir el submenu de puertos, volver a buscarlos (por si se conecto un cable USB)
    Private Sub mnuPuerto_DropDownOpening(sender As Object, e As EventArgs) Handles mnuPuerto.DropDownOpening
        LlenarMenuPuertos()
    End Sub

    Private Sub ElegirEntrada_Click(sender As Object, e As EventArgs)
        entradaSel = CInt(DirectCast(sender, ToolStripMenuItem).Tag)
        LlenarMenuEntrada()
        GuardarConfiguracion()
        ' Si estaba escuchando, reiniciar con la nueva entrada
        If waveIn IsNot Nothing Then
            DetenerCaptura()
            IniciarCaptura()
        End If
    End Sub

    Private Sub ElegirSalida_Click(sender As Object, e As EventArgs)
        salidaSel = CInt(DirectCast(sender, ToolStripMenuItem).Tag)
        LlenarMenuSalida()
        GuardarConfiguracion()
    End Sub

    Private Sub ElegirPuerto_Click(sender As Object, e As EventArgs)
        puertoSel = CStr(DirectCast(sender, ToolStripMenuItem).Tag)
        LlenarMenuPuertos()
        GuardarConfiguracion()
    End Sub

    ' Probar PTT: primer clic lo activa, segundo clic lo suelta (o se suelta solo a los 30 s)
    Private Sub mnuProbarPtt_Click(sender As Object, e As EventArgs) Handles mnuProbarPtt.Click
        If txArmado Then
            MessageBox.Show(Tr("Cancela la transmision antes de probar el PTT."))
            Return
        End If
        If tuneActivo Then DetenerTune("")
        If Not pruebaPttActiva Then
            If Not AbrirPuertoPtt() Then Return
            Ptt(True)
            pruebaPttActiva = True
            inicioPruebaPtt = DateTime.UtcNow
            mnuProbarPtt.Checked = True
            mnuProbarPtt.Text = Tr("Probar PTT") & "  (" & Tr("ACTIVO: clic para soltar") & ")"
            lblTx.ForeColor = Color.Red
            lblTx.Text = Tr("PTT ACTIVADO (prueba). Configurar > Probar PTT para soltarlo.")
        Else
            TerminarPruebaPtt(Tr("PTT soltado"))
        End If
    End Sub

    Private Sub TerminarPruebaPtt(motivo As String)
        CerrarPuertoPtt()
        pruebaPttActiva = False
        mnuProbarPtt.Checked = False
        mnuProbarPtt.Text = Tr("Probar PTT")
        lblTx.ForeColor = SystemColors.ControlText
        lblTx.Text = motivo
    End Sub

    Private ReadOnly Property MiCall As String
        Get
            Return miCallValor
        End Get
    End Property

    Private ReadOnly Property MiGrid As String
        Get
            Return miGridValor
        End Get
    End Property

    ' ==================================================================
    ' RECEPCION
    ' ==================================================================
    Private Sub btnEscuchar_Click(sender As Object, e As EventArgs) Handles btnEscuchar.Click
        If waveIn Is Nothing Then
            IniciarCaptura()
        Else
            DetenerCaptura()
        End If
    End Sub

    Private Sub IniciarCaptura()
        If entradaSel < 0 Then
            MessageBox.Show(Tr("Elige la entrada de audio en Configurar > Entrada de audio."))
            Return
        End If
        Try
            waveIn = New WaveInEvent()
            waveIn.DeviceNumber = entradaSel
            waveIn.WaveFormat = New WaveFormat(SampleRate, 16, 1) ' 12 kHz, 16 bits, mono
            waveIn.BufferMilliseconds = 50

            bufferCiclo.Clear()
            cicloActual = -1
            cicloIncompleto = True
            yaDecodificado = False
            bufferCascada.Clear()

            waveIn.StartRecording()
            btnEscuchar.Text = Tr("Detener")
            lblEstado.Text = Tr("Esperando inicio de ciclo...")
            If modoJtty Then IniciarJtty()
        Catch ex As Exception
            MessageBox.Show(Tr("No se pudo abrir la entrada de audio: {0}", ex.Message))
            waveIn?.Dispose()
            waveIn = Nothing
        End Try
    End Sub

    Private Sub DetenerCaptura()
        jttyHilo = Nothing            ' el hilo de JTTY termina solo
        If waveIn IsNot Nothing Then
            waveIn.StopRecording()
            waveIn.Dispose()
            waveIn = Nothing
        End If
        btnEscuchar.Text = Tr("Escuchar")
        lblEstado.Text = Tr("Detenido")
        barraNivel.Nivel = 0
    End Sub

    ' Llega audio (cada ~50 ms). Corre en un hilo de fondo.
    Private Sub waveIn_DataAvailable(sender As Object, e As WaveInEventArgs) Handles waveIn.DataAvailable
        Dim segundosUnix As Double = (DateTime.UtcNow - Epoca).TotalSeconds
        Dim periodoRx As Double = Periodo
        Dim ciclo As Long = CLng(Math.Floor(segundosUnix / periodoRx))

        ' Cambio de ciclo: empezar un buffer nuevo
        If ciclo <> cicloActual Then
            ' Se descarta el primer ciclo (empieza a la mitad) y los ciclos en que transmitimos
            cicloIncompleto = (cicloActual < 0) OrElse (ciclo = cicloTx)
            cicloActual = ciclo
            yaDecodificado = False
            bufferCiclo.Clear()
        End If

        ' Convertir de 16 bits a Single (-1 a +1) y guardar
        For i As Integer = 0 To e.BytesRecorded - 2 Step 2
            Dim muestra As Single = BitConverter.ToInt16(e.Buffer, i) / 32768.0F
            bufferCiclo.Add(muestra)
            bufferCascada.Add(muestra)
            If Math.Abs(muestra) > picoNivel Then picoNivel = Math.Abs(muestra)
        Next
        ActualizarCascada(ciclo)

        ' JTTY: no hay ciclos. El audio pasa al hilo que decodifica (menos mientras transmitimos)
        Dim enJtty As Boolean = modoJtty
        If enJtty AndAlso jttyHilo IsNot Nothing AndAlso Not txEnCurso AndAlso Not tuneActivo Then
            SyncLock jttyCola
                If jttyCola.Count < 60 * SampleRate Then
                    For i As Integer = 0 To e.BytesRecorded - 2 Step 2
                        jttyCola.Add(BitConverter.ToInt16(e.Buffer, i))
                    Next
                End If
            End SyncLock
        End If

        ' A los 14 s ya llego toda la senal FT8 (termina a los 13.1 s): decodificar ahora,
        ' asi hay tiempo de preparar la respuesta para el ciclo siguiente
        Dim segundoEnCiclo As Double = segundosUnix - ciclo * periodoRx
        Dim minimo As Integer = CInt(If(modoFT4, 6.0, 13.0) * SampleRate)
        If Not enJtty AndAlso Not yaDecodificado AndAlso Not cicloIncompleto AndAlso segundoEnCiclo >= SegundoDecodificar _
           AndAlso bufferCiclo.Count >= minimo Then
            yaDecodificado = True
            Dim audio As Single() = bufferCiclo.ToArray()
            Dim cicloDecodificar As Long = ciclo
            Dim ft4 As Boolean = modoFT4
            Task.Run(Sub() DecodificarCiclo(audio, cicloDecodificar, ft4))
        End If

        If Me.IsDisposed OrElse Not Me.IsHandleCreated Then Return
        Dim nivel As Integer = CInt(picoNivel * 100)
        picoNivel = 0
        Me.BeginInvoke(Sub()
                           If Not mostrandoTx Then barraNivel.Nivel = nivel
                           Dim txt = String.Format(Tr("Ciclo") & ": {0,4:F1} s", segundoEnCiclo)
                           If cicloIncompleto Then txt &= "   (" & Tr("ciclo no se decodifica") & ")"
                           If enJtty Then txt = If(txEnCurso, "JTTY: TX", Tr("JTTY: escuchando (1200 a 1800 Hz y tu frecuencia RX)"))
                           lblEstado.Text = txt
                       End Sub)
    End Sub

    ' Waterfall: calcular las lineas nuevas (hilo de audio)
    Private Sub ActualizarCascada(ciclo As Long)
        Dim nueva As Boolean = False
        While bufferCascada.Count >= FftN
            Dim datos(FftN - 1) As Complex
            For i As Integer = 0 To FftN - 1
                datos(i).X = bufferCascada(i) * ventanaFft(i)
                datos(i).Y = 0
            Next
            FastFourierTransform.FFT(True, FftM, datos)

            Dim bins As Integer = FftN \ 2
            Dim db(bins - 1) As Single
            For b As Integer = 0 To bins - 1
                Dim p As Double = datos(b).X * datos(b).X + datos(b).Y * datos(b).Y
                db(b) = CSng(10 * Math.Log10(p + 1.0E-20))
            Next

            ' Primera linea de cada ciclo: marca verde con la hora
            Dim etiqueta As String = Nothing
            If ciclo <> ultimoCicloCascada Then
                ultimoCicloCascada = ciclo
                etiqueta = Epoca.AddSeconds(ciclo * Periodo).ToString("HH:mm:ss")
            End If
            cascada.AgregarLinea(db, CSng(SampleRate) / FftN, etiqueta)
            bufferCascada.RemoveRange(0, FftSalto)
            nueva = True
        End While
        If nueva AndAlso Not Me.IsDisposed AndAlso Me.IsHandleCreated Then
            Me.BeginInvoke(Sub() cascada.Invalidate())
        End If
    End Sub

    ' Clic en el waterfall: esa es la nueva frecuencia de TX
    ' Clic en el waterfall: izquierdo = RX (verde), derecho = TX (rojo), Ctrl + clic = los dos
    Private Sub cascada_ClicFrecuencia(frecuencia As Single, cual As Integer) Handles cascada.ClicFrecuencia
        If cual = 0 OrElse cual = 2 Then   ' 0 = RX, 2 = ambos
            PonerFrecRx(frecuencia)
        End If
        If cual = 1 OrElse cual = 2 Then   ' 1 = TX, 2 = ambos
            Dim f As Decimal = CDec(Math.Round(frecuencia / 10.0) * 10)
            f = Math.Max(numFrecTx.Minimum, Math.Min(numFrecTx.Maximum, f))
            numFrecTx.Value = f
            cascada.FrecTx = CSng(f)
            ' Si ya hay un mensaje preparado, regenerarlo en la nueva frecuencia
            If planActual IsNot Nothing Then PrepararTx(planActual.Texto, planActual.DetenerDespues)
        End If
        lblTx.ForeColor = SystemColors.ControlText
        lblTx.Text = String.Format("RX {0:F0} Hz   TX {1} Hz", frecRx, numFrecTx.Value)
    End Sub

    ' Frecuencia de RX: marca verde en el waterfall y resalta los mensajes cercanos en la lista
    Private Sub PonerFrecRx(frecuencia As Single)
        frecRx = CSng(Math.Round(frecuencia))
        cascada.FrecRx = frecRx
        lblFrecRx.Text = frecRx.ToString("0") & " Hz"
        lstMensajes.Invalidate()
        CambioConfig(Nothing, EventArgs.Empty)
    End Sub

    ' Un mensaje esta "en la frecuencia de RX" si cae dentro del ancho de una senal
    Private Function CercaDeRx(d As Decodificado) As Boolean
        Return Math.Abs(d.Freq - frecRx) <= cascada.AnchoTxHz * 0.6F
    End Function

    ' Decodificar un ciclo (hilo de fondo)
    Private Sub DecodificarCiclo(audio As Single(), ciclo As Long, ft4 As Boolean)
        Dim resultados(99) As FT8Result
        ' AP: la DLL usa lo que ya sabemos (mi indicativo y, si hay QSO, el del DX) para sacar senales mas debiles
        Try
            FT8_SetAP(miCallValor, If(dxCall <> "" AndAlso txArmado, dxCall, ""), frecRx)
        Catch ex As EntryPointNotFoundException
            ' FT8Core.dll vieja (sin AP): se sigue igual
        End Try
        Dim cuantos As Integer = FT8_DecodeEx(audio, audio.Length, SampleRate, If(ft4, 1, 0), resultados, resultados.Length)
        Dim inicio As DateTime = Epoca.AddSeconds(ciclo * If(ft4, 7.5, 15.0))

        Dim lista As New List(Of Decodificado)
        For i As Integer = 0 To cuantos - 1
            Dim r = resultados(i)
            Dim d As New Decodificado()
            d.Hora = inicio
            d.Ciclo = ciclo
            d.Snr = CInt(Math.Round(r.Snr))
            d.Dt = r.TimeSec - 0.5F - LatenciaAudio ' FT8 transmite desde 0.5 s dentro del ciclo
            d.Freq = r.FreqHz
            d.Texto = r.Text
            d.Metodo = r.Score \ 1000     ' 0 normal, 1 OSD, 1x AP
            lista.Add(d)
        Next
        lista.Sort(Function(a, b) a.Freq.CompareTo(b.Freq))

        If Me.IsDisposed OrElse Not Me.IsHandleCreated Then Return
        Me.BeginInvoke(Sub()
                           lstMensajes.Items.Add(String.Format("------ {0:HH:mm:ss} UTC  {1} " & Tr("mensajes") & " ------", inicio, cuantos))
                           Dim bandaAhora As String = Banda(DialMHz())
                           For Each d In lista
                               Clasificar(d, bandaAhora)
                               lstMensajes.Items.Add(d)
                           Next
                           lstMensajes.TopIndex = Math.Max(0, lstMensajes.Items.Count - 1)
                           If mnuPsk.Checked Then ReportarPsk(lista, ft4)
                           SecuenciaAutomatica(lista)
                       End Sub)
    End Sub

    ' Anotar para PSKReporter quien transmitio cada mensaje (y su grid, si lo trae)
    Private Sub ReportarPsk(lista As List(Of Decodificado), ft4 As Boolean)
        Dim dialHz As Double = DialMHz() * 1000000.0
        If dialHz <= 0 Then Return
        For Each d In lista
            PskReporter.Agregar(d.Emisor, d.Grid, CLng(dialHz + d.Freq), d.Snr, If(ft4, "FT4", "FT8"), d.Hora)
        Next
    End Sub

    ' Quien transmitio un mensaje y su grid (si lo trae)
    Private Shared Sub EmisorYGrid(texto As String, ByRef quien As String, ByRef grid As String)
        quien = "" : grid = ""
        Dim t = texto.Replace("<", "").Replace(">", "").Split({" "c}, StringSplitOptions.RemoveEmptyEntries)
        If t.Length >= 2 AndAlso t(0) = "CQ" Then
            quien = LlamadorDeCQ(t)
            If EsGrid(t(t.Length - 1)) Then grid = t(t.Length - 1)
        ElseIf t.Length = 5 AndAlso t(1) = "RR73;" Then
            quien = t(3)                                      ' modo DXpedicion: el DX
        ElseIf t.Length >= 2 Then
            quien = t(1)
            If t.Length >= 3 AndAlso EsGrid(t(2)) Then grid = t(2)
        End If
        If quien = "..." Then quien = ""
    End Sub

    ' Pais y "novedad" de cada mensaje, para los colores de la lista
    ' Ultimo grid escuchado de cada estacion (para saber la distancia aunque en el QSO no lo mande)
    Private ReadOnly gridsVistos As New Dictionary(Of String, String)

    Private Sub Clasificar(d As Decodificado, banda As String)
        Dim quien As String = "", grid As String = ""
        EmisorYGrid(d.Texto, quien, grid)
        If quien <> "" AndAlso grid <> "" Then gridsVistos(quien) = grid
        d.Emisor = quien
        d.Grid = grid
        d.Pais = Paises.Buscar(quien)
        d.Nuevo = Trabajados.Evaluar(quien, banda, grid, d.Pais)
    End Sub

    ' Cargar cty.dat y los logs (el de Pako y el adicional) en segundo plano
    Private Sub CargarColores()
        Dim cty As String = Paises.BuscarArchivo()
        Dim logs As New List(Of String) From {RutaLog()}
        If My.Settings.LogColores <> "" Then logs.Add(My.Settings.LogColores)
        Task.Run(Sub()
                     Dim hayCty As Boolean = cty <> "" AndAlso Paises.Cargar(cty)
                     Trabajados.Cargar(logs)
                     If Me.IsDisposed OrElse Not Me.IsHandleCreated Then Return
                     Me.BeginInvoke(Sub()
                                        AnotarServicio(Tr("Colores: {0} QSOs en el log, {1} paises trabajados", Trabajados.CantidadQsos, Trabajados.CantidadPaises) &
                                                       If(hayCty, "", "  (" & Tr("falta cty.dat: sin paises; ver el manual") & ")"))
                                        lstMensajes.Invalidate()
                                    End Sub)
                 End Sub)
    End Sub

    ' Clic derecho: seleccionar la linea que esta bajo el cursor
    ' Mouse sobre una linea: mostrar la explicacion de cada dato
    Private Sub lstMensajes_MouseMove(sender As Object, e As MouseEventArgs) Handles lstMensajes.MouseMove
        Dim i As Integer = lstMensajes.IndexFromPoint(e.Location)
        If i = indiceAyuda Then Return
        indiceAyuda = i
        Dim d As Decodificado = If(i >= 0, TryCast(lstMensajes.Items(i), Decodificado), Nothing)
        ayudaLista.SetToolTip(lstMensajes, If(d Is Nothing, "", DescribirLinea(d)))
    End Sub

    Private Sub lstMensajes_MouseLeave(sender As Object, e As EventArgs) Handles lstMensajes.MouseLeave
        indiceAyuda = -1
        ayudaLista.SetToolTip(lstMensajes, "")
    End Sub

    Private Function DescribirLinea(d As Decodificado) As String
        Dim sb As New System.Text.StringBuilder()
        Dim rfMHz As Double = DialMHz() + d.Freq / 1000000.0
        Dim rf As String = rfMHz.ToString("0.000000", CultureInfo.InvariantCulture) & " MHz"

        If d.EsJtty Then
            sb.AppendLine(If(d.EsTx, Tr("TU TRANSMISION en JTTY a las {0:HH:mm:ss} UTC", d.Hora),
                                     Tr("Mensaje JTTY recibido a las {0:HH:mm:ss} UTC", d.Hora)))
            sb.AppendLine(Tr("Freq: {0:F0} Hz de audio  ->  en el aire: {1}", d.Freq, rf))
            If Not d.EsTx Then
                sb.AppendLine(If(d.Completo, Tr("Mensaje completo (llego la marca de fin)."),
                                             Tr("Mensaje en curso o cortado: el texto puede seguir creciendo.")))
                If d.Emisor <> "" AndAlso d.Pais <> "" Then sb.AppendLine(d.Emisor & " (" & d.Pais & ")")
                sb.AppendLine(Tr("Doble clic para contestar."))
            End If
            Return sb.ToString().TrimEnd()
        End If

        If d.EsTx Then
            sb.AppendLine(Tr("TU TRANSMISION - ciclo de las {0:HH:mm:ss} UTC", d.Hora))
            sb.AppendLine(Tr("Freq: {0:F0} Hz de audio  ->  en el aire: {1}", d.Freq, rf))
            sb.AppendLine(Tr("Mensaje") & ": " & ExplicarMensaje(d.Texto))
            Return sb.ToString().TrimEnd()
        End If

        sb.AppendLine(Tr("UTC {0:HHmmss}: ciclo de {1} s que empezo a las {0:HH:mm:ss} UTC", d.Hora, Periodo))
        sb.AppendLine(Tr("dB {0}: relacion senal/ruido (SNR). {1}", d.Snr, CalificarSnr(d.Snr)))
        sb.AppendLine(Tr("DT {0:F1}: desfase de tiempo en segundos. {1}", d.Dt,
                      If(Math.Abs(d.Dt) <= 0.5, Tr("Normal: los relojes estan sincronizados."),
                         Tr("Alto: el reloj de esa estacion (o el tuyo) esta desfasado."))))
        sb.AppendLine(Tr("Freq {0:F0}: frecuencia de audio en Hz  ->  en el aire: {1}", d.Freq, rf))
        sb.AppendLine(Tr("Mensaje") & ": " & ExplicarMensaje(d.Texto))
        If d.Metodo = 1 Then
            sb.AppendLine(Tr("Decodificado con OSD (segundo intento, para senales muy debiles)."))
        ElseIf d.Metodo >= 11 Then
            sb.AppendLine(Tr("Decodificado con AP (usando indicativos ya conocidos) para una senal muy debil."))
        End If
        If d.Emisor <> "" Then
            Dim estado As String
            Select Case d.Nuevo
                Case Novedad.NuevoPais : estado = Tr("PAIS NUEVO: nunca lo has trabajado.")
                Case Novedad.NuevoPaisBanda : estado = Tr("pais ya trabajado, pero es nuevo en esta banda.")
                Case Novedad.NuevoGrid : estado = Tr("grid {0} nuevo: nunca lo has trabajado.", d.Grid)
                Case Novedad.NuevoIndicativo : estado = Tr("nunca has hecho QSO con {0}.", d.Emisor)
                Case Novedad.OtraBanda : estado = Tr("ya trabajaste a {0}, pero en otra banda.", d.Emisor)
                Case Else : estado = Tr("ya trabajaste a {0} en esta banda.", d.Emisor)
            End Select
            sb.AppendLine(d.Emisor & If(d.Pais <> "", " (" & d.Pais & ")", "") & ": " & estado)
        End If

        ' Distancia y rumbo, si el mensaje trae grid
        Dim t = Tokens(d.Texto)
        Dim grid As String = If(t.Length >= 2 AndAlso EsGrid(t(t.Length - 1)), t(t.Length - 1), "")
        If grid <> "" AndAlso EsGrid(MiGrid) Then
            Dim km As Double, rumbo As Double
            DistanciaYRumbo(MiGrid, grid, km, rumbo)
            sb.AppendLine(Tr("Distancia: {0:N0} km, rumbo {1:F0} grados desde tu estacion ({2})", km, rumbo, MiGrid))
        End If
        sb.AppendLine(Tr("Doble clic para contestar."))
        Return sb.ToString().TrimEnd()
    End Function

    Private Shared Function CalificarSnr(snr As Integer) As String
        If snr >= 0 Then Return Tr("Senal muy fuerte.")
        If snr >= -10 Then Return Tr("Senal buena.")
        If snr >= -18 Then Return Tr("Senal debil, pero se decodifica bien.")
        Return Tr("Muy debil, cerca del limite del modo (FT8 unos -24 dB, FT4 unos -17 dB).")
    End Function

    ' Explica en palabras que dice un mensaje FT8
    Private Function ExplicarMensaje(texto As String) As String
        Dim mi As String = MiCall
        Dim crudo = texto.Replace("<", "").Replace(">", "").Split({" "c}, StringSplitOptions.RemoveEmptyEntries)
        If crudo.Length = 5 AndAlso crudo(1) = "RR73;" Then
            Dim dxTxt As String = If(crudo(3) = "...", Tr("la estacion DX"), crudo(3))
            Dim r0 As String = Tr("modo DXpedicion: {0} cierra el QSO con {1} (RR73) y al mismo tiempo le da a {2} un reporte de {3} dB",
                                  dxTxt, crudo(0), crudo(2), crudo(4))
            If crudo(0) = mi Then r0 &= "   <<< " & Tr("TU QSO QUEDO CONFIRMADO")
            If crudo(2) = mi Then r0 &= "   <<< " & Tr("TE DA REPORTE A TI")
            Return r0
        End If

        Dim t = Tokens(texto)
        If t.Length = 0 Then Return texto

        If t(0) = "CQ" Then
            Dim llamador As String = LlamadorDeCQ(t)
            Dim grid As String = If(EsGrid(t(t.Length - 1)), t(t.Length - 1), "")
            Dim r As String = Tr("llamada general (CQ) de {0}", llamador) & If(grid <> "", ", grid " & grid, "")
            If t.Length >= 4 OrElse (t.Length = 3 AndAlso Not EsGrid(t(2))) Then
                r &= ". " & Tr("Solo busca estaciones de: {0}", t(1))
            End If
            Return r
        End If

        If t.Length < 2 Then Return Tr("texto libre")
        Dim a As String = t(0), b As String = t(1)
        Dim extra As String = If(t.Length >= 3, t(2), "")
        Dim r2 As String
        If extra = "" Then
            r2 = Tr("{0} llama a {1}", b, a)
        ElseIf EsGrid(extra) Then
            r2 = Tr("{0} le contesta a {1} y le da su grid {2}", b, a, extra)
        ElseIf EsReporte(extra) Then
            r2 = Tr("{0} le da a {1} un reporte de {2} dB", b, a, extra)
        ElseIf EsRReporte(extra) Then
            r2 = Tr("{0} confirma (R) el reporte de {1} y le da {2} dB", b, a, extra.Substring(1))
        ElseIf extra = "RR73" Then
            r2 = Tr("{0} confirma todo y cierra el QSO con {1} (RR73)", b, a)
        ElseIf extra = "RRR" Then
            r2 = Tr("{0} confirma que recibio todo (RRR)", b)
        ElseIf extra = "73" Then
            r2 = Tr("{0} se despide de {1} (73): QSO terminado", b, a)
        Else
            r2 = Tr("mensaje de otro tipo (concurso, texto libre, etc.)")
        End If
        If a = mi Then r2 &= "   <<< " & Tr("DIRIGIDO A TI")
        Return r2
    End Function

    ' Distancia (km) y rumbo (grados) entre dos grids de 4 caracteres
    Private Shared Sub DistanciaYRumbo(desde As String, hasta As String, ByRef km As Double, ByRef rumbo As Double)
        Dim lat1, lon1, lat2, lon2 As Double
        GridALatLon(desde, lat1, lon1)
        GridALatLon(hasta, lat2, lon2)
        Dim rad As Double = Math.PI / 180.0
        Dim dLat As Double = (lat2 - lat1) * rad, dLon As Double = (lon2 - lon1) * rad
        Dim h As Double = Math.Sin(dLat / 2) ^ 2 + Math.Cos(lat1 * rad) * Math.Cos(lat2 * rad) * Math.Sin(dLon / 2) ^ 2
        km = 2 * 6371.0 * Math.Asin(Math.Min(1.0, Math.Sqrt(h)))
        Dim y As Double = Math.Sin(dLon) * Math.Cos(lat2 * rad)
        Dim x As Double = Math.Cos(lat1 * rad) * Math.Sin(lat2 * rad) - Math.Sin(lat1 * rad) * Math.Cos(lat2 * rad) * Math.Cos(dLon)
        rumbo = (Math.Atan2(y, x) / rad + 360.0) Mod 360.0
    End Sub

    ' Centro de un grid Maidenhead de 4 caracteres (ej. EK70)
    Private Shared Sub GridALatLon(grid As String, ByRef lat As Double, ByRef lon As Double)
        lon = (AscW(grid(0)) - AscW("A"c)) * 20 - 180 + (AscW(grid(2)) - AscW("0"c)) * 2 + 1
        lat = (AscW(grid(1)) - AscW("A"c)) * 10 - 90 + (AscW(grid(3)) - AscW("0"c)) + 0.5
    End Sub

    Private Sub lstMensajes_MouseDown(sender As Object, e As MouseEventArgs) Handles lstMensajes.MouseDown
        If e.Button <> MouseButtons.Right Then Return
        Dim i As Integer = lstMensajes.IndexFromPoint(e.Location)
        If i >= 0 Then lstMensajes.SelectedIndex = i
    End Sub

    ' Colores de la lista
    Private Sub lstMensajes_DrawItem(sender As Object, e As DrawItemEventArgs) Handles lstMensajes.DrawItem
        If e.Index < 0 Then Return
        Dim item As Object = lstMensajes.Items(e.Index)
        Dim fondo As Color = Color.White
        Dim letra As Color = Color.Black

        If TypeOf item Is String Then
            fondo = Color.Gainsboro
            ' Lineas de los servicios de log: verde si salio bien, rosado si fallo
            Dim t As String = CStr(item)
            If t.StartsWith("*** " & MarcaError) Then
                fondo = Color.MistyRose
            ElseIf t.StartsWith("*** " & MarcaBien) Then
                fondo = Color.Honeydew
            End If
        Else
            Dim d = DirectCast(item, Decodificado)
            Dim esCq As Boolean = d.Texto.StartsWith("CQ ")
            If d.EsTx Then
                fondo = Color.Khaki
            ElseIf Tokens(d.Texto).Contains(MiCall) Then
                fondo = Color.LightCoral
            ElseIf d.Nuevo = Novedad.NuevoPais Then
                fondo = Color.Violet
            ElseIf d.Nuevo = Novedad.NuevoPaisBanda Then
                fondo = Color.FromArgb(225, 195, 255)
            ElseIf esCq AndAlso d.Nuevo = Novedad.NuevoGrid Then
                fondo = Color.LightSkyBlue
            ElseIf esCq AndAlso d.Nuevo = Novedad.Ninguna AndAlso d.Emisor <> "" AndAlso Trabajados.CantidadQsos > 0 Then
                fondo = Color.FromArgb(222, 238, 222)      ' ya trabajado en esta banda
                letra = Color.DimGray
            ElseIf esCq Then
                fondo = Color.LightGreen
            End If
        End If
        If (e.State And DrawItemState.Selected) = DrawItemState.Selected Then
            fondo = SystemColors.Highlight
            letra = SystemColors.HighlightText
        End If

        Using pincel As New SolidBrush(fondo)
            e.Graphics.FillRectangle(pincel, e.Bounds)
        End Using
        ' Barra verde a la izquierda: mensaje en tu frecuencia de RX
        Dim dRx = TryCast(item, Decodificado)
        If dRx IsNot Nothing AndAlso Not dRx.EsTx AndAlso CercaDeRx(dRx) Then
            Using verde As New SolidBrush(Color.ForestGreen)
                e.Graphics.FillRectangle(verde, e.Bounds.X, e.Bounds.Y, 5, e.Bounds.Height)
            End Using
        End If
        TextRenderer.DrawText(e.Graphics, item.ToString(), lstMensajes.Font, e.Bounds, letra,
                              TextFormatFlags.Left Or TextFormatFlags.VerticalCenter Or TextFormatFlags.NoPrefix)

        ' A la derecha: el pais, y si es nuevo
        If dRx IsNot Nothing AndAlso Not dRx.EsTx AndAlso dRx.Pais <> "" Then
            Dim marca As String = ""
            Select Case dRx.Nuevo
                Case Novedad.NuevoPais : marca = Tr("NUEVO") & "  "
                Case Novedad.NuevoPaisBanda : marca = Tr("nuevo en banda") & "  "
                Case Novedad.NuevoGrid : If dRx.Grid <> "" Then marca = Tr("grid nuevo") & "  "
            End Select
            Dim r As New Rectangle(e.Bounds.X, e.Bounds.Y, e.Bounds.Width - 6, e.Bounds.Height)
            Dim colorPais As Color = If(letra = SystemColors.HighlightText, letra, Color.FromArgb(70, 70, 70))
            TextRenderer.DrawText(e.Graphics, marca & dRx.Pais, lstMensajes.Font, r, colorPais,
                                  TextFormatFlags.Right Or TextFormatFlags.VerticalCenter Or TextFormatFlags.NoPrefix)
        End If
    End Sub

    ' ==================================================================
    ' QSO: contestar y secuencia automatica
    ' ==================================================================
    Private Sub lstMensajes_DoubleClick(sender As Object, e As EventArgs) Handles lstMensajes.DoubleClick
        Dim d = TryCast(lstMensajes.SelectedItem, Decodificado)
        If d Is Nothing OrElse d.EsTx Then Return
        If MiCall = "" OrElse MiGrid = "" Then
            MessageBox.Show(Tr("Escribe tu indicativo y tu grid en Configurar > Mi estacion."))
            Return
        End If
        If d.EsJtty Then
            ResponderJtty(d)
            Return
        End If
        If modoJtty Then Return  ' linea de FT8 que quedo en la lista: en JTTY no se contesta
        PonerFrecRx(d.Freq)      ' escuchar en la frecuencia de esa estacion (TX se queda donde esta)
        ResponderA(d, True)
    End Sub

    ' Despues de cada ciclo decodificado: si alguien nos contesto, avanzar el QSO
    Private Sub SecuenciaAutomatica(lista As List(Of Decodificado))
        Dim mi As String = MiCall
        ActualizarCola(lista)
        If Not chkAutoSeq.Checked OrElse Not txArmado Then Return

        ' La estacion del QSO volvio a llamar CQ o le esta contestando a otro,
        ' y no hay ningun mensaje suyo para nosotros: dejar de repetir
        ' (Si ya estamos enviando el ultimo mensaje, RR73 o 73, el QSO esta completo:
        '  es normal que el DX ya siga con otro, asi que se deja salir ese ultimo mensaje)
        Dim enviandoFinal As Boolean = planActual IsNot Nothing AndAlso planActual.DetenerDespues
        ' (Si todavia solo lo estamos llamando con nuestro grid, es normal que el DX vuelva a llamar CQ
        '  o atienda a otro: se sigue llamando, como WSJT-X; la vigilancia lo detiene a las 12 veces)
        Dim yaHayReportes As Boolean = planActual IsNot Nothing AndAlso
            Regex.IsMatch(planActual.Texto, " R?[+-][0-9]{2}$")
        If dxCall <> "" AndAlso Not EstamosLlamandoCQ() AndAlso Not enviandoFinal AndAlso yaHayReportes Then
            Dim suyos = lista.Where(Function(d)
                                        Dim t = Tokens(d.Texto)
                                        If t.Length < 2 Then Return False
                                        If t(0) = "CQ" Then Return LlamadorDeCQ(t) = dxCall
                                        Return t(1) = dxCall
                                    End Function).ToList()
            Dim paraNosotros = suyos.Any(Function(d) Tokens(d.Texto).FirstOrDefault() = mi)
            If suyos.Count > 0 AndAlso Not paraNosotros Then
                Dim yaTeniamosTodo As Boolean = planActual IsNot Nothing AndAlso
                    Regex.IsMatch(planActual.Texto, " R[+-][0-9]{2}$")
                Dim aviso As String = If(yaTeniamosTodo,
                    Tr("{0}: probablemente mando RR73 y no lo copiaste. 'Log QSO' si quieres registrarlo.", dxCall),
                    Tr("QSO con {0} incompleto", dxCall))
                lstMensajes.Items.Add("*** " & aviso)
                lstMensajes.TopIndex = Math.Max(0, lstMensajes.Items.Count - 1)
                If chkCola.Checked Then
                    AvanzarCola()
                Else
                    DesarmarTx(Tr("{0} siguio con otra estacion o volvio a llamar CQ.", dxCall))
                    lblQso.Text = aviso
                End If
                Return
            End If
        End If

        ' Mensajes dirigidos a nosotros; si ya hay un QSO, solo los de esa estacion
        Dim paraMi = lista.Where(Function(d)
                                     Dim t = Tokens(d.Texto)
                                     If t.Length < 2 OrElse t(0) <> mi Then Return False
                                     If dxCall = "" Then Return EsLlamadaInicial(t)
                                     Return t(1) = dxCall
                                 End Function).OrderByDescending(Function(d) d.Snr).ToList()

        ' Si estamos llamando CQ, cualquiera que conteste inicia el QSO
        If paraMi.Count = 0 AndAlso EstamosLlamandoCQ() Then
            paraMi = lista.Where(Function(d)
                                     Dim t = Tokens(d.Texto)
                                     Return t.Length >= 2 AndAlso t(0) = mi AndAlso EsLlamadaInicial(t)
                                 End Function).OrderByDescending(Function(d) d.Snr).ToList()
        End If

        If paraMi.Count > 0 Then ResponderA(paraMi(0), False)
    End Sub

    ' Un mensaje "para mi" que inicia un QSO: solo indicativos, grid o reporte (no 73 / RR73 / RRR)
    Private Shared Function EsLlamadaInicial(t As String()) As Boolean
        Dim extra As String = If(t.Length >= 3, t(2), "")
        Return extra = "" OrElse EsGrid(extra) OrElse EsReporte(extra)
    End Function

    ' Guardar quien nos llama (y no es el QSO actual) y olvidar a los que ya no llaman
    Private Sub ActualizarCola(lista As List(Of Decodificado))
        Dim mi As String = MiCall
        For Each d In lista
            Dim t = Tokens(d.Texto)
            If t.Length >= 2 AndAlso t(0) = mi AndAlso t(1) <> dxCall AndAlso EsLlamadaInicial(t) Then
                llamadores(t(1)) = d
            End If
        Next
        Dim cicloAhora As Long = CLng(Math.Floor((DateTime.UtcNow - Epoca).TotalSeconds / Periodo))
        For Each k In llamadores.Keys.ToList()
            If llamadores(k).Ciclo < cicloAhora - CiclosEnCola Then llamadores.Remove(k)
        Next
    End Sub

    ' QSO terminado: seguir con el siguiente de la cola, o volver a llamar CQ
    Private Sub AvanzarCola()
        Dim anterior As String = dxCall
        Dim cicloAhora As Long = CLng(Math.Floor((DateTime.UtcNow - Epoca).TotalSeconds / Periodo))
        Dim candidatos As New List(Of Decodificado)
        For Each d In llamadores.Values
            Dim quien As String = Tokens(d.Texto)(1)
            If quien = anterior Then Continue For
            If d.Ciclo < cicloAhora - CiclosEnCola Then Continue For
            ' no repetir con alguien ya registrado hace poco
            If quien = ultimoRegistrado AndAlso (DateTime.UtcNow - horaUltimoRegistro).TotalMinutes < 10 Then Continue For
            candidatos.Add(d)
        Next
        ' el que llamo mas recientemente; a igualdad, el mas fuerte
        candidatos = candidatos.OrderByDescending(Function(d) d.Ciclo).ThenByDescending(Function(d) d.Snr).ToList()
        If candidatos.Count > 0 Then
            Dim siguiente = candidatos(0)
            llamadores.Remove(Tokens(siguiente.Texto)(1))
            ResponderA(siguiente, False)
            lblTx.ForeColor = SystemColors.ControlText
            lblTx.Text = Tr("Cola: siguiente QSO con {0}", dxCall)
        Else
            TerminarQso()
            If PrepararTx("CQ " & MiCall & " " & MiGrid, False) Then
                lblTx.ForeColor = SystemColors.ControlText
                lblTx.Text = Tr("Nadie en espera: volviendo a llamar CQ")
            End If
        End If
    End Sub

    ' Se transmitio el ultimo mensaje de un QSO (RR73 o 73)
    Private Sub FinDeQso()
        If chkCola.Checked AndAlso txArmado Then
            AvanzarCola()
        Else
            QsoCerrado(Tr("QSO terminado"))
        End If
    End Sub

    ' QSO terminado sin cola: dejar de transmitir y dejar listo un CQ en la casilla
    ' (asi "Transmitir" no repite el RR73 / 73 del QSO anterior)
    Private Sub QsoCerrado(motivo As String)
        Dim anterior As String = dxCall
        DesarmarTx(motivo)
        TerminarQso()
        If MiCall <> "" AndAlso MiGrid <> "" Then PrepararTx("CQ " & MiCall & " " & MiGrid, False)
        If anterior <> "" Then
            Dim texto As String = lblQso.Text
            Dim i As Integer = texto.IndexOf(vbCrLf)
            lblQso.Text = Tr("QSO con {0} terminado", anterior) & If(i >= 0, texto.Substring(i), "")
        End If
    End Sub

    Private Function EstamosLlamandoCQ() As Boolean
        Return planActual IsNot Nothing AndAlso planActual.Texto.StartsWith("CQ ")
    End Function

    ' Decide el siguiente mensaje segun lo que recibimos
    Private Sub ResponderA(d As Decodificado, manual As Boolean)
        Dim t = Tokens(d.Texto)
        Dim mi As String = MiCall
        If t.Length < 2 Then Return

        Dim siguiente As String = Nothing
        Dim detener As Boolean = False

        If t(0) = "CQ" Then
            ' --- Alguien llama CQ: le contestamos con nuestro grid ---
            Dim llamador As String = LlamadorDeCQ(t)
            If llamador = "" OrElse llamador = mi Then Return
            dxCall = llamador
            dxGrid = If(EsGrid(t(t.Length - 1)), t(t.Length - 1), "")
            reporteEnviado = FormatoReporte(d.Snr)
            reporteRecibido = ""
            siguiente = dxCall & " " & mi & " " & MiGrid

        ElseIf t(0) = mi Then
            ' --- Mensaje dirigido a nosotros ---
            Dim de As String = t(1)
            Dim extra As String = If(t.Length >= 3, t(2), "")
            If dxCall <> de Then
                dxCall = de
                dxGrid = ""
                reporteRecibido = ""
            End If

            If extra = "" OrElse EsGrid(extra) Then            ' nos contesta el CQ -> reporte
                If extra <> "" Then dxGrid = extra
                reporteEnviado = FormatoReporte(d.Snr)
                siguiente = de & " " & mi & " " & reporteEnviado
            ElseIf EsReporte(extra) Then                       ' nos da reporte -> R + reporte
                reporteRecibido = extra
                If reporteEnviado = "" Then reporteEnviado = FormatoReporte(d.Snr)
                siguiente = de & " " & mi & " R" & reporteEnviado
            ElseIf EsRReporte(extra) Then                      ' R + reporte -> RR73 (QSO completo)
                reporteRecibido = extra.Substring(1)
                If reporteEnviado = "" Then reporteEnviado = FormatoReporte(d.Snr)
                siguiente = de & " " & mi & " RR73"
                detener = True
                RegistrarQso()
            ElseIf extra = "RR73" OrElse extra = "RRR" Then    ' RR73 -> 73 (QSO completo)
                siguiente = de & " " & mi & " 73"
                detener = True
                RegistrarQso()
            ElseIf extra = "73" Then                           ' 73 -> terminado
                RegistrarQso()
                If txArmado AndAlso Not manual AndAlso Not chkCola.Checked Then QsoCerrado(Tr("QSO con {0} terminado", de))
                Return
            Else
                Return
            End If

        Else
            ' --- Mensaje entre otras estaciones: llamamos al que transmitio (solo con doble clic) ---
            If Not manual Then Return
            Dim de As String = t(1)
            If de = mi Then Return
            dxCall = de
            dxGrid = If(t.Length >= 3 AndAlso EsGrid(t(2)), t(2), "")
            reporteEnviado = FormatoReporte(d.Snr)
            reporteRecibido = ""
            siguiente = de & " " & mi & " " & MiGrid
        End If

        ' Con doble clic: transmitir en el ciclo contrario al de la otra estacion
        If manual Then chkPar.Checked = Not EsCicloPar(d.Ciclo)
        ' En el QSO se usa nuestra frecuencia de TX actual (no se cambia)

        llamadores.Remove(dxCall)   ' ya no esta en espera
        If Not PrepararTx(siguiente, detener) Then Return
        If Not detener Then MostrarQso()
        If manual AndAlso Not txArmado Then ArmarTx()
    End Sub

    ' ==================================================================
    ' Utilidades de mensajes
    ' ==================================================================
    Private Function Tokens(texto As String) As String()
        Dim t = texto.Replace("<", "").Replace(">", "").Split({" "c}, StringSplitOptions.RemoveEmptyEntries)

        ' Modo DXpedicion: "K1ABC RR73; W9XYZ <DX> -12" = dos mensajes en uno.
        ' Se convierte en el mensaje que le importa a este operador:
        '   si el RR73 es para mi      -> "MI DX RR73"
        '   si el reporte es para mi   -> "MI DX -12"
        '   si no es para mi           -> "W9XYZ DX -12" (el DX sigue con otra estacion)
        If t.Length = 5 AndAlso t(1) = "RR73;" Then
            Dim mi As String = MiCall
            Dim dx As String = t(3)
            If dx = "..." AndAlso dxCall <> "" AndAlso (t(0) = mi OrElse t(2) = mi) Then dx = dxCall
            If t(0) = mi Then Return {mi, dx, "RR73"}
            Return {t(2), dx, t(4)}
        End If
        Return t
    End Function

    Private Shared Function EsGrid(s As String) As Boolean
        Return s <> "RR73" AndAlso Regex.IsMatch(s, "^[A-R]{2}[0-9]{2}$")
    End Function

    Private Shared Function EsReporte(s As String) As Boolean
        Return Regex.IsMatch(s, "^[+-][0-9]{2}$")
    End Function

    Private Shared Function EsRReporte(s As String) As Boolean
        Return Regex.IsMatch(s, "^R[+-][0-9]{2}$")
    End Function

    ' "CQ K1ABC FN42", "CQ DX K1ABC FN42", "CQ POTA K1ABC FN42", "CQ K1ABC"
    Private Shared Function LlamadorDeCQ(t As String()) As String
        If t.Length = 2 Then Return t(1)
        If t.Length = 3 Then Return If(EsGrid(t(2)), t(1), t(2))
        If t.Length >= 4 Then Return t(2)
        Return ""
    End Function

    Private Shared Function FormatoReporte(snr As Integer) As String
        Dim v As Integer = Math.Max(-30, Math.Min(49, snr))
        Return If(v >= 0, "+", "-") & Math.Abs(v).ToString("00")
    End Function

    Private Shared Function EsCicloPar(ciclo As Long) As Boolean
        Return ciclo Mod 2 = 0   ' :00 y :30 son ciclos pares
    End Function

    ' ==================================================================
    ' Registro de QSOs (formato ADIF, en Documentos\Pako_log.adi)
    ' ==================================================================
    Private Sub RegistrarQso()
        If dxCall = "" Then Return
        ' No registrar dos veces el mismo QSO
        If dxCall = ultimoRegistrado AndAlso (DateTime.UtcNow - horaUltimoRegistro).TotalMinutes < 10 Then Return

        Dim ahora As DateTime = DateTime.UtcNow
        Dim dial As Double = DialMHz()
        Dim frecMHz As Double = dial + CDbl(numFrecTx.Value) / 1000000.0

        Dim linea As String =
            Campo("CALL", dxCall) & Campo("GRIDSQUARE", dxGrid) &
            If(modoJtty, Campo("MODE", "MFSK") & Campo("SUBMODE", "JTTY"),
               If(modoFT4, Campo("MODE", "MFSK") & Campo("SUBMODE", "FT4"), Campo("MODE", "FT8"))) &
            Campo("RST_SENT", reporteEnviado) & Campo("RST_RCVD", reporteRecibido) &
            Campo("QSO_DATE", ahora.ToString("yyyyMMdd")) & Campo("TIME_ON", ahora.ToString("HHmmss")) &
            Campo("BAND", Banda(dial)) & Campo("FREQ", frecMHz.ToString("0.000000", CultureInfo.InvariantCulture)) &
            Campo("STATION_CALLSIGN", MiCall) & Campo("MY_GRIDSQUARE", MiGrid) & "<EOR>"

        Try
            Dim ruta As String = RutaLog()
            If Not File.Exists(ruta) Then
                ' ADIF solo admite ASCII en el encabezado: "Pako" sin dieresis
                File.WriteAllText(ruta, Adif.Encabezado())
            End If
            File.AppendAllText(ruta, linea & vbCrLf)
            ultimoRegistrado = dxCall
            ultimoRegistroAdif = linea
            Trabajados.Agregar(dxCall, Banda(dial), dxGrid)
            horaUltimoRegistro = ahora
            lblQso.Text = Tr("QSO con {0} registrado en el log", dxCall)
            If modoJtty Then
                ' JTTY todavia no existe como modo en QRZ, eQSL ni LoTW: queda solo en el log local
                AnotarServicio(Tr("QSO en JTTY con {0} guardado en el log local (los servicios en linea aun no aceptan JTTY)", dxCall))
            Else
                SubirQso(linea, dxCall)      ' QRZ / eQSL / LoTW, segun lo activado
            End If
        Catch ex As Exception
            MessageBox.Show(Tr("No se pudo guardar el log: {0}", ex.Message))
        End Try
    End Sub

    ' Ruta del log: Documentos\Pako_log.adi (renombra el log viejo de FT8Win si existe)
    Private Shared Function RutaLog() As String
        Dim documentos As String = Environment.GetFolderPath(Environment.SpecialFolder.MyDocuments)
        Dim ruta As String = Path.Combine(documentos, "Pako_log.adi")
        Dim rutaVieja As String = Path.Combine(documentos, "FT8Win_log.adi")
        If Not File.Exists(ruta) AndAlso File.Exists(rutaVieja) Then File.Move(rutaVieja, ruta)
        Return ruta
    End Function

    ' ==================================================================
    ' SERVICIOS DE LOG (QRZ.com, eQSL, LoTW)
    ' ==================================================================
    Private Shared ReadOnly Servicios() As String = {"QRZ", "eQSL", "LoTW"}

    Private Shared Function ServicioActivo(servicio As String) As Boolean
        Select Case servicio
            Case "QRZ" : Return My.Settings.QrzActivo
            Case "eQSL" : Return My.Settings.EqslActivo
            Case Else : Return My.Settings.LotwActivo
        End Select
    End Function

    Private Shared Function ServicioConfigurado(servicio As String) As Boolean
        Select Case servicio
            Case "QRZ" : Return Credenciales.Descifrar(My.Settings.QrzApiKey) <> ""
            Case "eQSL" : Return My.Settings.EqslUsuario <> "" AndAlso Credenciales.Descifrar(My.Settings.EqslClave) <> ""
            Case Else : Return My.Settings.LotwTqsl <> "" AndAlso My.Settings.LotwUbicacion <> ""
        End Select
    End Function

    ' Sube registros a un servicio. En QRZ va de uno en uno; "pendientes" recibe los que fallaron.
    Private Async Function SubirAServicio(servicio As String, registros As List(Of String),
                                          pendientes As List(Of String),
                                          Optional avance As IProgress(Of String) = Nothing) As Task(Of ResultadoSubida)
        Dim r As ResultadoSubida
        Select Case servicio
            Case "QRZ"
                Return Await ServiciosLog.QrzSubirVariosAsync(Credenciales.Descifrar(My.Settings.QrzApiKey),
                                                              registros, avance, pendientes)
            Case "eQSL"
                r = Await ServiciosLog.EqslSubirAsync(My.Settings.EqslUsuario,
                                                      Credenciales.Descifrar(My.Settings.EqslClave), registros)
            Case Else
                r = Await ServiciosLog.LotwSubirAsync(My.Settings.LotwTqsl, My.Settings.LotwUbicacion,
                                                      My.Settings.LotwDesde, My.Settings.LotwHasta, registros)
        End Select
        ' eQSL y LoTW van en un solo envio: si fallo, quedan todos pendientes
        If r.Reintentar AndAlso pendientes IsNot Nothing Then pendientes.AddRange(registros)
        Return r
    End Function

    ' Al registrar un QSO: subirlo a cada servicio activado (en paralelo, sin frenar la operacion)
    Private Async Sub SubirQso(registro As String, indicativo As String)
        Dim tareas As New List(Of Task)
        For Each servicio In Servicios
            If ServicioActivo(servicio) AndAlso ServicioConfigurado(servicio) Then
                tareas.Add(SubirQsoA(servicio, registro, indicativo))
            End If
        Next
        Await Task.WhenAll(tareas)
    End Sub

    Private Async Function SubirQsoA(servicio As String, registro As String, indicativo As String) As Task
        Try
            Dim fallidos As New List(Of String)
            Dim r = Await SubirAServicio(servicio, New List(Of String) From {registro}, fallidos)
            For Each f In fallidos
                ColaPendientes.Agregar(servicio, f)
            Next
            AnotarServicio(servicio & ": " & indicativo & " " & r.Resumen(), If(r.Estado = EstadoSubida.Subido OrElse r.Estado = EstadoSubida.Duplicado, 1, 2))
        Catch ex As Exception
            ColaPendientes.Agregar(servicio, registro)
            AnotarServicio(servicio & ": " & indicativo & " " & Tr("error: {0} (queda pendiente)", ex.Message), 2)
        End Try
        ActualizarIndicadorPendientes()
    End Function

    ' Log > Ver trafico: una sola ventana, se puede dejar abierta mientras operas
    Private frmTrafico As FrmTrafico

    Private Sub MostrarTrafico()
        If frmTrafico Is Nothing OrElse frmTrafico.IsDisposed Then
            frmTrafico = New FrmTrafico()
            frmTrafico.Show(Me)
        Else
            If frmTrafico.WindowState = FormWindowState.Minimized Then frmTrafico.WindowState = FormWindowState.Normal
            frmTrafico.Activate()
        End If
    End Sub

    ' Deja una linea gris en la lista de mensajes
    ' estado: 0 neutro (gris), 1 bien (verde), 2 error (rosado). La marca invisible guarda el color.
    Private Shared ReadOnly MarcaBien As String = ChrW(&H200B)
    Private Shared ReadOnly MarcaError As String = ChrW(&H200C)

    Private Sub AnotarServicio(texto As String, Optional estado As Integer = 0)
        If Me.IsDisposed Then Return
        lstMensajes.Items.Add("*** " & If(estado = 1, MarcaBien, If(estado = 2, MarcaError, "")) & texto)
        lstMensajes.TopIndex = Math.Max(0, lstMensajes.Items.Count - 1)
    End Sub

    ' Log > Subir pendientes
    ' automatico = True: reintento solo (cada 10 min), sin ventanas y sin llenar la lista mientras no haya internet
    Private Async Sub SubirPendientes(Optional automatico As Boolean = False)
        If subiendoPendientes Then Return
        subiendoPendientes = True
        Dim algo As Boolean = False
        Try
            For Each servicio In Servicios
                Dim registros = ColaPendientes.Leer(servicio)
                If registros.Count = 0 Then Continue For
                algo = True
                If Not ServicioConfigurado(servicio) Then
                    If Not automatico Then AnotarServicio(servicio & ": " & Tr("{0} pendientes, pero faltan las credenciales (Configurar > Servicios de log)", registros.Count), 2)
                    Continue For
                End If
                If Not automatico Then AnotarServicio(servicio & ": " & Tr("subiendo {0} pendientes...", registros.Count))
                Dim siguenPendientes As New List(Of String)
                Dim avance As New Progress(Of String)(Sub(t) If Not automatico Then lblTx.Text = t)
                Dim r = Await SubirAServicio(servicio, registros, siguenPendientes, avance)
                ColaPendientes.Reescribir(servicio, siguenPendientes)
                ' En automatico, solo se anota si algo se subio (sin internet no se llena la lista)
                If Not automatico OrElse r.Subidos + r.Duplicados > 0 OrElse r.Estado = EstadoSubida.ErrorAutorizacion Then
                    AnotarServicio(Tr("{0}: pendientes -> subidos {1}, ya estaban {2}, siguen pendientes {3}",
                                             servicio, r.Subidos, r.Duplicados, siguenPendientes.Count) &
                               If(r.Estado = EstadoSubida.ErrorAutorizacion OrElse r.Estado = EstadoSubida.Error, "  (" & r.Resumen() & ")", ""),
                               If(siguenPendientes.Count > 0 OrElse r.Estado = EstadoSubida.ErrorAutorizacion OrElse r.Estado = EstadoSubida.Error, 2, 1))
                End If
            Next
        Finally
            subiendoPendientes = False
            ActualizarIndicadorPendientes()
        End Try
        If Not algo AndAlso Not automatico Then MessageBox.Show(Tr("No hay QSOs pendientes de subir."), NombrePrograma)
    End Sub

    Private Function ContarPendientes() As Integer
        Dim n As Integer = 0
        For Each sv In Servicios
            n += ColaPendientes.Cantidad(sv)
        Next
        Return n
    End Function

    ' Aviso naranja arriba: "3 QSOs sin subir"
    Private Sub ActualizarIndicadorPendientes()
        If Me.IsDisposed Then Return
        Dim n As Integer = ContarPendientes()
        lnkPendientes.Visible = n > 0
        If n > 0 Then lnkPendientes.Text = ChrW(&H26A0) & " " & Tr("{0} QSOs sin subir", n)
    End Sub

    Private Sub lnkPendientes_LinkClicked(sender As Object, e As LinkLabelLinkClickedEventArgs) Handles lnkPendientes.LinkClicked
        SubirPendientes()
    End Sub

    ' Log > Subir log completo a ...
    Private Async Sub SubirLogCompleto(servicio As String)
        If Not ServicioConfigurado(servicio) Then
            MessageBox.Show(Tr("Primero configura {0} en Configurar > Servicios de log.", servicio), NombrePrograma)
            Return
        End If
        Dim ruta As String = RutaLog()
        If Not File.Exists(ruta) Then
            MessageBox.Show(Tr("Todavia no hay QSOs en el log."), NombrePrograma)
            Return
        End If
        Dim registros = Adif.Registros(File.ReadAllText(ruta))
        If MessageBox.Show(Tr("CONFIRMAR_LOG_COMPLETO", registros.Count, servicio),
                           NombrePrograma, MessageBoxButtons.YesNo, MessageBoxIcon.Question) <> DialogResult.Yes Then Return

        AnotarServicio(servicio & ": " & Tr("subiendo el log completo ({0} QSOs)...", registros.Count))
        Dim avance As New Progress(Of String)(Sub(t) lblTx.Text = t)
        Dim r = Await SubirAServicio(servicio, registros, Nothing, avance)
        Dim resumen As String = Tr("{0}: log completo -> subidos {1}, ya estaban {2}, errores {3}",
                                   servicio, r.Subidos, r.Duplicados, r.Errores)
        AnotarServicio(resumen, If(r.Errores > 0 OrElse r.Estado = EstadoSubida.ErrorAutorizacion OrElse r.Estado = EstadoSubida.ErrorRed, 2, 1))
        If r.Estado = EstadoSubida.ErrorAutorizacion OrElse r.Estado = EstadoSubida.ErrorRed OrElse
           (r.Estado = EstadoSubida.Error AndAlso r.Subidos = 0) Then
            MessageBox.Show(resumen & vbCrLf & vbCrLf & r.Resumen(), NombrePrograma)
        End If
    End Sub

    ' Frecuencias de dial estandar (USB)
    Private Shared ReadOnly FrecuenciasFT8() As String = {
        "160m  1.840", "80m  3.573", "60m  5.357", "40m  7.074", "30m  10.136", "20m  14.074",
        "17m  18.100", "15m  21.074", "12m  24.915", "10m  28.074", "6m  50.313"}
    Private Shared ReadOnly FrecuenciasFT4() As String = {
        "80m  3.575", "40m  7.0475", "30m  10.140", "20m  14.080",
        "17m  18.104", "15m  21.140", "12m  24.919", "10m  28.180", "6m  50.318"}

    ' JTTY: las frecuencias de dial que trae WSJT-X 3.2 (la actividad esta cerca de 1500 Hz de audio)
    Private Shared ReadOnly FrecuenciasJTTY() As String = {
        "160m  1.838", "80m  3.575", "40m  7.090", "30m  10.140", "20m  14.090",
        "17m  18.100", "15m  21.090", "12m  24.920", "10m  28.090"}

    ' Llenar la lista de frecuencias del modo actual, conservando la banda elegida
    Private Sub LlenarBandas()
        Dim bandaAntes As String = If(cmbBanda.SelectedItem Is Nothing, "20m",
                                      cmbBanda.SelectedItem.ToString().Split(" "c)(0))
        cmbBanda.Items.Clear()
        cmbBanda.Items.AddRange(If(modoJtty, FrecuenciasJTTY, If(modoFT4, FrecuenciasFT4, FrecuenciasFT8)))
        For i As Integer = 0 To cmbBanda.Items.Count - 1
            If cmbBanda.Items(i).ToString().Split(" "c)(0) = bandaAntes Then cmbBanda.SelectedIndex = i : Exit For
        Next
        If cmbBanda.SelectedIndex < 0 Then cmbBanda.SelectedIndex = 0
    End Sub

    ' Cambio de modo: FT8, FT4 o JTTY
    Private Sub cmbModo_SelectedIndexChanged(sender As Object, e As EventArgs) Handles cmbModo.SelectedIndexChanged
        Dim ft4Nuevo As Boolean = (cmbModo.SelectedIndex = 1)
        Dim jttyNuevo As Boolean = (cmbModo.SelectedIndex = 2)
        If ft4Nuevo = modoFT4 AndAlso jttyNuevo = modoJtty Then Return
        If jttyNuevo AndAlso Not AsegurarJtty() Then
            cmbModo.SelectedIndex = If(modoFT4, 1, 0)       ' falta jtty_pako.dll: se queda en el modo anterior
            Return
        End If
        If txArmado Then DesarmarTx(Tr("Modo cambiado: transmision detenida"))
        planActual = Nothing
        llamadores.Clear()
        jttyHilo = Nothing                   ' detener el decodificador de JTTY (si estaba)
        modoFT4 = ft4Nuevo
        modoJtty = jttyNuevo
        cicloActual = -1                     ' el audio empieza un ciclo nuevo (se descarta el primero)
        LlenarBandas()
        chkPar.Text = If(modoFT4, Tr("Par (00/15/30/45)"), Tr("Par (00/30)"))
        ' ancho de la senal: FT8 8 x 6.25 Hz, FT4 4 x 20.8 Hz, JTTY 4 x 31.25 Hz
        cascada.AnchoTxHz = If(modoJtty, AnchoJttyHz, If(modoFT4, 83.0F, 50.0F))
        cascada.Invalidate()

        ' En JTTY no hay ciclos ni secuencia automatica: se escribe y se transmite al momento
        chkPar.Enabled = Not modoJtty
        chkAutoSeq.Visible = Not modoJtty
        chkCola.Visible = Not modoJtty
        pnlMacros.Visible = modoJtty
        txtMensaje.MaxLength = If(modoJtty, MaxLetrasJtty, 0)
        lblMensaje.Text = If(modoJtty, Tr("Mensaje (Enter = transmitir ya)"), Tr("Mensaje (Enter = cambiarlo)"))
        If modoJtty Then
            TerminarQso()
            txtMensaje.Text = TextoMacro(0)
            lblTx.ForeColor = SystemColors.ControlText
            lblTx.Text = Tr("JTTY: escribe y presiona Enter, o usa F1 a F4. Doble clic en un mensaje para contestar.")
            If waveIn IsNot Nothing Then IniciarJtty()
        ElseIf MiCall <> "" AndAlso MiGrid <> "" Then
            txtMensaje.Text = "CQ " & MiCall & " " & MiGrid
            lblTx.ForeColor = SystemColors.ControlText
            lblTx.Text = Tr("Doble clic en un mensaje para contestar.")
        End If
        lstMensajes.Items.Add("====== " & Tr("Modo") & " " & cmbModo.Text & " ======")
        lstMensajes.TopIndex = Math.Max(0, lstMensajes.Items.Count - 1)
    End Sub

    ' Frecuencia de dial: la escrita a mano si hay, si no la de la lista
    Private Function DialMHz() As Double
        If Cat.Conectado AndAlso dialCatHz > 0 Then Return dialCatHz / 1000000.0
        Dim valor As Double
        Dim texto As String = txtDialOtra.Text.Trim().Replace(",", ".")
        If texto <> "" AndAlso Double.TryParse(texto, NumberStyles.Float, CultureInfo.InvariantCulture, valor) AndAlso valor > 0 Then
            Return valor
        End If
        If cmbBanda.SelectedItem Is Nothing Then Return 0
        Dim partes = cmbBanda.SelectedItem.ToString().Split({" "c}, StringSplitOptions.RemoveEmptyEntries)
        Double.TryParse(partes(partes.Length - 1), NumberStyles.Float, CultureInfo.InvariantCulture, valor)
        Return valor
    End Function

    ' ==================================================================
    ' CAT (Hamlib)
    ' ==================================================================
    Private ReadOnly ayudaCat As New ToolTip()

    Private Sub ConectarCat()
        If My.Settings.CatModelo = 0 Then
            MostrarEstadoCat()
            Return
        End If
        Dim carpeta As String = Cat.BuscarHamlib(My.Settings.CatHamlib)
        Dim modelo As Integer = My.Settings.CatModelo
        Dim puerto As String = My.Settings.CatPuerto
        Dim baudios As Integer = My.Settings.CatBaudios
        txtDialOtra.BackColor = Color.FromArgb(255, 245, 200)   ' amarillo: conectando
        Task.Run(Sub()
                     Dim ok As Boolean = Cat.Conectar(carpeta, modelo, puerto, baudios)
                     If Me.IsDisposed OrElse Not Me.IsHandleCreated Then Return
                     Me.BeginInvoke(Sub()
                                        If ok Then
                                            dialCatHz = Cat.FrecuenciaHz
                                            MostrarEstadoCat()
                                            AnotarServicio("CAT: " & Tr("conectado al radio ({0} MHz)", (dialCatHz / 1000000.0).ToString("0.000000", CultureInfo.InvariantCulture)), 1)
                                        Else
                                            MostrarEstadoCat()
                                            AnotarServicio("CAT: " & Tr("error al conectar: {0}", Cat.UltimoError), 2)
                                        End If
                                    End Sub)
                 End Sub)
    End Sub

    ' Con CAT, la casilla "u otra" muestra la frecuencia del radio y no se edita
    Private Sub MostrarEstadoCat()
        If Cat.Conectado Then
            txtDialOtra.ReadOnly = True
            txtDialOtra.BackColor = Color.FromArgb(225, 245, 225)
            txtDialOtra.Text = (dialCatHz / 1000000.0).ToString("0.000###", CultureInfo.InvariantCulture)
            ayudaCat.SetToolTip(txtDialOtra, Tr("Frecuencia del radio, leida por CAT (Hamlib)."))
        Else
            If txtDialOtra.ReadOnly Then txtDialOtra.Text = ""
            txtDialOtra.ReadOnly = False
            txtDialOtra.BackColor = SystemColors.Window
            ayudaCat.SetToolTip(txtDialOtra, Tr("Otra frecuencia de dial en MHz (ej. 14.080). Si esta vacia se usa la de la lista.") &
                                If(My.Settings.CatModelo = 0, "", vbCrLf & Tr("CAT desconectado: {0}", Cat.UltimoError)))
        End If
    End Sub

    ' El radio cambio de frecuencia (desde el hilo del CAT)
    Private Sub Cat_FrecuenciaCambio(hz As Long)
        If vfoDesplazado Then Return          ' es nuestro propio movimiento de split
        If Me.IsDisposed OrElse Not Me.IsHandleCreated Then Return
        Me.BeginInvoke(Sub()
                           dialCatHz = hz
                           MostrarEstadoCat()
                           ' Si coincide con una frecuencia de la lista, marcarla (sin volver a mandarla al radio)
                           Dim mhz As Double = hz / 1000000.0
                           For i As Integer = 0 To cmbBanda.Items.Count - 1
                               Dim partes = cmbBanda.Items(i).ToString().Split({" "c}, StringSplitOptions.RemoveEmptyEntries)
                               Dim v As Double
                               If Double.TryParse(partes(partes.Length - 1), NumberStyles.Float, CultureInfo.InvariantCulture, v) AndAlso
                                  Math.Abs(v - mhz) < 0.0005 AndAlso cmbBanda.SelectedIndex <> i Then
                                   cambiandoDesdeCat = True
                                   cmbBanda.SelectedIndex = i
                                   cambiandoDesdeCat = False
                                   Exit For
                               End If
                           Next
                       End Sub)
    End Sub

    Private Sub Cat_Desconectado(motivo As String)
        If Me.IsDisposed OrElse Not Me.IsHandleCreated Then Return
        Me.BeginInvoke(Sub()
                           MostrarEstadoCat()
                           AnotarServicio("CAT: " & motivo, 2)
                       End Sub)
    End Sub

    ' Elegir una banda en la lista: con CAT, llevar el radio a esa frecuencia en USB
    Private Sub BandaElegida(sender As Object, e As EventArgs)
        If cambiandoDesdeCat OrElse Not Cat.Conectado OrElse cmbBanda.SelectedItem Is Nothing Then Return
        Dim partes = cmbBanda.SelectedItem.ToString().Split({" "c}, StringSplitOptions.RemoveEmptyEntries)
        Dim mhz As Double
        If Not Double.TryParse(partes(partes.Length - 1), NumberStyles.Float, CultureInfo.InvariantCulture, mhz) Then Return
        Dim hz As Long = CLng(Math.Round(mhz * 1000000.0))
        If txArmado OrElse txEnCurso Then Return      ' no mover el radio en plena transmision
        Task.Run(Sub()
                     If Cat.PonerFrecuencia(hz) Then
                         Cat.PonerModoUsb()
                         Me.BeginInvoke(Sub()
                                            dialCatHz = hz
                                            MostrarEstadoCat()
                                        End Sub)
                     End If
                 End Sub)
    End Sub

    ' Split Fake It: cuanto mover el VFO para la frecuencia de audio TX actual
    Private Function DesplazamientoSplit() As Integer
        If Not Cat.Conectado OrElse Not My.Settings.CatSplit Then Return 0
        Return Cat.DesplazamientoFakeIt(CDbl(numFrecTx.Value))
    End Function

    ' Deslizador de nivel TX: se aplica al instante, incluso durante la transmision
    Private Sub trkTx_Scroll(sender As Object, e As EventArgs) Handles trkTx.Scroll
        ActualizarNivelTx()
    End Sub

    Private Sub ActualizarNivelTx()
        volumenTx = trkTx.Value / 100.0F
        Dim prov = volumenEnCurso
        If prov IsNot Nothing Then prov.Volume = volumenTx
        Dim db As String = If(trkTx.Value = 0, "-inf", (20 * Math.Log10(volumenTx)).ToString("0.0"))
        lblNivelTx.Text = trkTx.Value & "% (" & db & " dB)"
    End Sub

    Private Shared Function Campo(nombre As String, valor As String) As String
        If String.IsNullOrEmpty(valor) Then Return ""
        Return "<" & nombre & ":" & valor.Length & ">" & valor & " "
    End Function

    Private Shared Function Banda(mhz As Double) As String
        Dim desde() As Double = {1.8, 3.5, 5.3, 7.0, 10.1, 14.0, 18.068, 21.0, 24.89, 28.0, 50.0}
        Dim hasta() As Double = {2.0, 4.0, 5.45, 7.3, 10.15, 14.35, 18.168, 21.45, 24.99, 29.7, 54.0}
        Dim nombre() As String = {"160m", "80m", "60m", "40m", "30m", "20m", "17m", "15m", "12m", "10m", "6m"}
        For i As Integer = 0 To desde.Length - 1
            If mhz >= desde(i) AndAlso mhz <= hasta(i) Then Return nombre(i)
        Next
        Return ""
    End Function

    ' ==================================================================
    ' PTT por RTS
    ' ==================================================================
    Private Function AbrirPuertoPtt() As Boolean
        If puertoPtt IsNot Nothing AndAlso puertoPtt.IsOpen Then Return True
        If puertoSel = "" Then
            MessageBox.Show(Tr("Elige el puerto del PTT en Configurar > Puerto PTT."))
            Return False
        End If
        Try
            puertoPtt = New SerialPort(puertoSel)
            puertoPtt.RtsEnable = False   ' asegurar PTT apagado al abrir
            puertoPtt.DtrEnable = False
            puertoPtt.Open()
            puertoPtt.RtsEnable = False
            mnuPuerto.Enabled = False   ' no cambiar de puerto mientras esta abierto
            Return True
        Catch ex As Exception
            MessageBox.Show(Tr("No se pudo abrir {0}: {1}", puertoSel, ex.Message) &
                            vbCrLf & vbCrLf & Tr("Si WSJT-X esta abierto, cierralo: no pueden usar el mismo puerto a la vez."))
            puertoPtt = Nothing
            Return False
        End Try
    End Function

    Private Sub Ptt(encendido As Boolean)
        Try
            If puertoPtt IsNot Nothing AndAlso puertoPtt.IsOpen Then puertoPtt.RtsEnable = encendido
        Catch
        End Try
    End Sub

    Private Sub CerrarPuertoPtt()
        Ptt(False)
        Try
            If puertoPtt IsNot Nothing Then puertoPtt.Close()
        Catch
        End Try
        puertoPtt = Nothing
        mnuPuerto.Enabled = True
    End Sub


    ' ==================================================================
    ' TRANSMISION
    ' ==================================================================
    Private Sub btnTx_Click(sender As Object, e As EventArgs) Handles btnTx.Click
        If txArmado Then
            DesarmarTx(Tr("Transmision cancelada"))
            Return
        End If
        If modoJtty Then
            TransmitirJtty(txtMensaje.Text)
            Return
        End If
        If AplicarMensajeManual(txtMensaje.Text) Then ArmarTx()
    End Sub

    ' Enter en la casilla del mensaje: cambiar lo que se transmite (aunque ya este transmitiendo)
    Private Sub txtMensaje_KeyDown(sender As Object, e As KeyEventArgs) Handles txtMensaje.KeyDown
        If e.KeyCode <> Keys.Enter Then Return
        e.SuppressKeyPress = True
        If modoJtty Then
            TransmitirJtty(txtMensaje.Text)      ' JTTY: Enter transmite de una vez
            Return
        End If
        If AplicarMensajeManual(txtMensaje.Text) Then
            lblTx.ForeColor = SystemColors.ControlText
            lblTx.Text = Tr("Proximo mensaje: {0}", planActual.Texto) & If(txArmado, "", "  (" & Tr("dale Transmitir") & ")")
        End If
    End Sub

    ' Mensaje escrito a mano: entender que es y preparar la transmision
    Private Function AplicarMensajeManual(texto As String) As Boolean
        texto = texto.Trim().ToUpper()
        Dim t = Tokens(texto)
        Dim detener As Boolean = False
        If t.Length >= 1 AndAlso t(0) = "CQ" Then
            TerminarQso()                                  ' llamando CQ: no hay QSO
        ElseIf t.Length >= 3 AndAlso t(1) = MiCall Then
            If t(0) <> dxCall Then                         ' QSO con otra estacion
                dxCall = t(0)
                dxGrid = ""
                reporteRecibido = ""
            End If
            Dim ultimo As String = t(t.Length - 1)
            If EsReporte(ultimo) Then reporteEnviado = ultimo
            If EsRReporte(ultimo) Then reporteEnviado = ultimo.Substring(1)
            If ultimo = "RR73" OrElse ultimo = "RRR" OrElse ultimo = "73" Then
                detener = True                             ' se envia una sola vez
                RegistrarQso()
            Else
                MostrarQso()
            End If
        End If
        Return PrepararTx(texto, detener)
    End Function

    ' Texto del cuadro QSO: indicativo, grid, pais y distancia
    Private Sub MostrarQso()
        If dxCall = "" Then Return
        If dxGrid = "" AndAlso gridsVistos.ContainsKey(dxCall) Then dxGrid = gridsVistos(dxCall)
        Dim t As String = "QSO: " & dxCall
        Dim pais As String = Paises.Buscar(dxCall)
        Dim extra As New List(Of String)
        If dxGrid <> "" Then extra.Add(dxGrid)
        If pais <> "" Then extra.Add(pais)
        If extra.Count > 0 Then t &= "  (" & String.Join(", ", extra) & ")"
        If dxGrid <> "" AndAlso EsGrid(MiGrid) Then
            Dim km As Double, rumbo As Double
            DistanciaYRumbo(MiGrid, dxGrid, km, rumbo)
            t &= vbCrLf & km.ToString("N0") & " km,  " & Tr("rumbo") & " " & rumbo.ToString("0") & ChrW(&HB0)
        End If
        lblQso.Text = t
    End Sub

    ' Boton "Reset QSO": abandonar el QSO actual, dejar de transmitir y dejar listo el CQ
    Private Sub btnReset_Click(sender As Object, e As EventArgs) Handles btnReset.Click
        Dim anterior As String = dxCall
        DesarmarTx(If(anterior <> "", Tr("QSO con {0} cancelado", anterior), Tr("Listo para llamar CQ")))
        TerminarQso()
        llamadores.Clear()
        If modoJtty Then
            txtMensaje.Text = TextoMacro(0)
            Return
        End If
        If MiCall <> "" AndAlso MiGrid <> "" Then PrepararTx("CQ " & MiCall & " " & MiGrid, False)
    End Sub

    Private Sub TerminarQso()
        dxCall = ""
        dxGrid = ""
        reporteEnviado = ""
        reporteRecibido = ""
        lblQso.Text = ""
    End Sub

    ' Boton CQ: terminar el QSO actual y llamar CQ
    Private Sub btnCQ_Click(sender As Object, e As EventArgs) Handles btnCQ.Click
        If MiCall = "" OrElse MiGrid = "" Then
            MessageBox.Show(Tr("Escribe tu indicativo y tu grid en Configurar > Mi estacion."))
            Return
        End If
        If modoJtty Then
            If Not txEnCurso Then TerminarQso()
            TransmitirJtty(TextoMacro(0))
            Return
        End If
        TerminarQso()
        If PrepararTx("CQ " & MiCall & " " & MiGrid, False) AndAlso Not txArmado Then ArmarTx()
    End Sub

    ' Boton Log QSO: registrar a mano el QSO actual
    Private Sub btnLog_Click(sender As Object, e As EventArgs) Handles btnLog.Click
        If dxCall = "" Then
            MessageBox.Show(Tr("No hay un QSO en curso para registrar."))
            Return
        End If
        If modoJtty AndAlso dxCall = ultimoRegistrado AndAlso (DateTime.UtcNow - horaUltimoRegistro).TotalMinutes < 10 Then
            lblQso.Text = Tr("QSO con {0} registrado en el log", dxCall)
            Return
        End If
        If dxCall = ultimoRegistrado AndAlso (DateTime.UtcNow - horaUltimoRegistro).TotalMinutes < 10 Then
            ' Ya esta en el log: no se duplica en el archivo, pero se sube a los servicios marcados
            Dim activos = ServiciosListos()
            If activos.Count = 0 Then
                MessageBox.Show(Tr("QSO_YA_EN_LOG_SIN_SERVICIOS", dxCall), NombrePrograma)
                Return
            End If
            AnotarServicio(Tr("{0} ya estaba en el log: subiendolo a {1}...", dxCall, String.Join(", ", activos)))
            SubirQso(ultimoRegistroAdif, dxCall)
            Return
        End If
        RegistrarQso()
    End Sub

    ' Servicios marcados y con credenciales
    Private Shared Function ServiciosListos() As List(Of String)
        Return Servicios.Where(Function(s) ServicioActivo(s) AndAlso ServicioConfigurado(s)).ToList()
    End Function

    ' Genera el audio de un mensaje y lo deja listo para el proximo ciclo de TX
    Private Function PrepararTx(texto As String, detenerDespues As Boolean) As Boolean
        Dim muestras(15 * SampleRateTx - 1) As Single
        Dim desplazamiento As Integer = DesplazamientoSplit()
        Dim n As Integer = FT8_EncodeEx(texto, CSng(numFrecTx.Value) - desplazamiento, SampleRateTx, ModoDll, muestras, muestras.Length)
        If n < 0 Then
            MessageBox.Show(Tr("El mensaje '{0}' no es valido para FT8 (codigo {1}).", texto, n))
            Return False
        End If

        ' Convertir a 16 bits a escala casi completa (el nivel real lo pone el deslizador Nivel TX)
        Dim pcm(n * 2 - 1) As Byte
        For i As Integer = 0 To n - 1
            Dim v As Short = CShort(Math.Round(muestras(i) * 0.9F * 32767.0F))
            pcm(2 * i) = CByte(v And &HFF)
            pcm(2 * i + 1) = CByte((v >> 8) And &HFF)
        Next

        ' Mensaje distinto al anterior: reiniciar la vigilancia
        If txArmado AndAlso (planActual Is Nothing OrElse planActual.Texto <> texto) Then transmisionesHechas = 0
        planActual = New PlanTx With {.Texto = texto, .Audio = pcm, .DetenerDespues = detenerDespues, .Desplazamiento = desplazamiento}
        txtMensaje.Text = texto
        Return True
    End Function

    Private Sub ArmarTx()
        If salidaSel < 0 Then
            MessageBox.Show(Tr("Elige la salida de audio en Configurar > Salida de audio."))
            Return
        End If
        If pruebaPttActiva Then TerminarPruebaPtt("") ' no mezclar con la prueba de PTT
        If tuneActivo Then DetenerTune("")
        If Not AbrirPuertoPtt() Then Return
        dispositivoSalida = salidaSel
        transmisionesHechas = 0
        txArmado = True
        btnTx.Text = Tr("Cancelar TX")
        btnTx.BackColor = Color.Orange
        mnuSalida.Enabled = False   ' no cambiar la salida de audio mientras transmite
        numFrecTx.Enabled = False
        lblTx.ForeColor = SystemColors.ControlText
        lblTx.Text = If(chkPar.Checked, Tr("Esperando el proximo ciclo par..."), Tr("Esperando el proximo ciclo impar..."))
    End Sub

    Private Sub DesarmarTx(motivo As String)
        txArmado = False
        If Not txEnCurso Then CerrarPuertoPtt()
        btnTx.Text = Tr("Transmitir")
        btnTx.BackColor = SystemColors.Control
        mnuSalida.Enabled = True
        numFrecTx.Enabled = True
        lblTx.ForeColor = SystemColors.ControlText
        lblTx.Text = motivo
    End Sub

    ' Cada 100 ms: si falta menos de 1 s para un ciclo de la paridad elegida, preparar la transmision
    Private Sub tmrTx_Tick(sender As Object, e As EventArgs) Handles tmrTx.Tick
        lblReloj.Text = DateTime.UtcNow.ToString("HH:mm:ss") & " UTC"
        If mnuPsk.Checked Then PskReporter.Revisar()
        ' Cada 10 s: aviso de pendientes; cada 10 min: reintentar subirlos
        If DateTime.UtcNow >= proximaRevision Then
            proximaRevision = DateTime.UtcNow.AddSeconds(10)
            ActualizarIndicadorPendientes()
            If DateTime.UtcNow >= proximoReintento AndAlso Not txEnCurso AndAlso Not subiendoPendientes Then
                proximoReintento = DateTime.UtcNow.AddMinutes(MinutosReintento)
                If ContarPendientes() > 0 Then SubirPendientes(True)
            End If
        End If
        If pruebaPttActiva AndAlso (DateTime.UtcNow - inicioPruebaPtt).TotalSeconds > MaxPruebaPttSeg Then
            TerminarPruebaPtt(Tr("Prueba de PTT terminada (maximo {0} s)", MaxPruebaPttSeg))
        End If
        If tuneActivo Then
            Dim seg As Integer = CInt((DateTime.UtcNow - inicioTune).TotalSeconds)
            If seg >= MaxTuneSeg Then
                DetenerTune(Tr("Tune apagado solo (maximo {0} s)", MaxTuneSeg))
            Else
                tuneGenerador.Frequency = CDbl(numFrecTx.Value)   ' sigue a la frecuencia TX
                btnTune.Text = "Tune  (" & (MaxTuneSeg - seg) & " s)"
            End If
        End If
        If Not txArmado OrElse txEnCurso OrElse modoJtty Then Return   ' JTTY no espera ciclos

        Dim t As Double = (DateTime.UtcNow - Epoca).TotalSeconds
        Dim periodoTx As Double = Periodo
        Dim proximo As Long = CLng(Math.Floor(t / periodoTx)) + 1
        Dim faltan As Double = proximo * periodoTx - t

        ' Ciclo en que toca transmitir: el proximo (si falta menos de 1 s), o el actual si
        ' recien empezo (arranque tardio: el doble clic suele llegar 1-2 s despues del inicio;
        ' las otras estaciones lo decodifican igual, con un DT un poco mayor)
        Dim actual As Long = proximo - 1
        Dim transcurrido As Double = t - actual * periodoTx
        Dim maxTarde As Double = If(periodoTx > 10, MaxInicioTardeFT8, MaxInicioTardeFT4)
        Dim cicloElegido As Long = -1
        If faltan < 1.0 AndAlso EsCicloPar(proximo) = chkPar.Checked Then
            cicloElegido = proximo
        ElseIf transcurrido < maxTarde AndAlso EsCicloPar(actual) = chkPar.Checked AndAlso actual <> cicloTx Then
            cicloElegido = actual
        End If

        If cicloElegido >= 0 Then
            If transmisionesHechas >= MaxTransmisiones Then
                DesarmarTx(Tr("Detenido por vigilancia ({0} transmisiones del mismo mensaje)", MaxTransmisiones))
                Return
            End If
            txEnCurso = True
            cicloTx = cicloElegido
            transmisionesHechas += 1
            Dim dispositivo = dispositivoSalida
            Task.Run(Sub() TransmitirCiclo(cicloElegido, periodoTx, dispositivo))
        End If
    End Sub

    ' Transmite un ciclo completo (hilo de fondo)
    Private Sub TransmitirCiclo(ciclo As Long, periodoTx As Double, dispositivo As Integer)
        Dim inicioCiclo As DateTime = Epoca.AddSeconds(ciclo * periodoTx)
        Dim finQso As Boolean = False
        Dim dialBase As Long = dialCatHz
        Try
            ' Split Fake It: mover el VFO antes de transmitir (el audio ya esta generado para eso)
            Dim planPrevio As PlanTx = planActual
            If Cat.Conectado AndAlso planPrevio IsNot Nothing AndAlso planPrevio.Desplazamiento <> 0 AndAlso dialBase > 0 Then
                vfoDesplazado = True
                Cat.PonerFrecuencia(dialBase + planPrevio.Desplazamiento)
            End If

            ' Esperar al inicio del ciclo y activar el PTT
            EsperarHasta(inicioCiclo)
            If Not txArmado Then Return
            Ptt(True)

            ' Esperar al segundo 0.5 (menos el retardo de la salida).
            ' El mensaje se lee recien aqui: asi alcanza a cambiar si la secuencia automatica lo actualizo.
            EsperarHasta(inicioCiclo.AddSeconds(0.5 - LatenciaSalida))
            Dim plan As PlanTx = planActual
            If plan Is Nothing OrElse Not txArmado Then Return
            ' Si el mensaje cambio a ultimo momento y necesita otro desplazamiento, corregir el VFO
            If Cat.Conectado AndAlso dialBase > 0 AndAlso (vfoDesplazado OrElse plan.Desplazamiento <> 0) Then
                If plan.Desplazamiento <> If(planPrevio Is Nothing, 0, planPrevio.Desplazamiento) Then
                    vfoDesplazado = True
                    Cat.PonerFrecuencia(dialBase + plan.Desplazamiento)
                End If
            End If

            ' Si el mensaje cambia en los primeros segundos (doble clic tardio), se vuelve a empezar con el nuevo
            Dim maxCambio As Double = If(periodoTx > 10, 1.8, 0.8)
            Dim desplActual As Integer = If(vfoDesplazado, plan.Desplazamiento, 0)
            Dim cambiar As Boolean
            Do
            cambiar = False
            If Cat.Conectado AndAlso dialBase > 0 AndAlso plan.Desplazamiento <> desplActual Then
                vfoDesplazado = True
                Cat.PonerFrecuencia(dialBase + plan.Desplazamiento)
                desplActual = plan.Desplazamiento
            End If
            MostrarTx(plan, inicioCiclo)
            Using stream As New RawSourceWaveStream(New MemoryStream(plan.Audio), New WaveFormat(SampleRateTx, 16, 1))
                Using salida As New WaveOutEvent()
                    salida.DeviceNumber = dispositivo
                    salida.DesiredLatency = 100
                    salida.NumberOfBuffers = 2
                    Dim conVolumen As New VolumeSampleProvider(stream.ToSampleProvider())
                    conVolumen.Volume = volumenTx
                    volumenEnCurso = conVolumen

                    ' Medidor: cada 50 ms informa el pico de lo que sale hacia el radio
                    Dim medidor As New MeteringSampleProvider(conVolumen, SampleRateTx \ 20)
                    AddHandler medidor.StreamVolume, AddressOf MedidorTx_StreamVolume
                    mostrandoTx = True
                    Me.BeginInvoke(Sub() barraNivel.EsTx = True)

                    salida.Init(medidor, True)   ' True = salida en 16 bits
                    salida.Play()
                    Dim limite As DateTime = inicioCiclo.AddSeconds(periodoTx - 0.5) ' nunca pasar del ciclo
                    While salida.PlaybackState = PlaybackState.Playing AndAlso DateTime.UtcNow < limite AndAlso txArmado
                        Dim nuevo As PlanTx = planActual
                        If nuevo IsNot Nothing AndAlso nuevo IsNot plan AndAlso
                           (DateTime.UtcNow - inicioCiclo).TotalSeconds < maxCambio Then
                            plan = nuevo
                            cambiar = True
                            Exit While
                        End If
                        Thread.Sleep(20)
                    End While
                    salida.Stop()
                    volumenEnCurso = Nothing
                    RemoveHandler medidor.StreamVolume, AddressOf MedidorTx_StreamVolume
                End Using
            End Using
            Loop While cambiar AndAlso txArmado

            ' Ultimo mensaje del QSO (RR73 o 73): no repetir, salvo que la secuencia ya haya puesto otro
            If plan.DetenerDespues AndAlso planActual Is plan Then finQso = True
        Catch ex As Exception
            txArmado = False
            If Not Me.IsDisposed AndAlso Me.IsHandleCreated Then
                Me.BeginInvoke(Sub() MessageBox.Show(Tr("Error al transmitir: {0}", ex.Message)))
            End If
        Finally
            Ptt(False)
            If vfoDesplazado Then
                Cat.PonerFrecuencia(dialBase)       ' devolver el VFO a la frecuencia de dial
                vfoDesplazado = False
            End If
            txEnCurso = False
            mostrandoTx = False
            If Not Me.IsDisposed AndAlso Me.IsHandleCreated Then Me.BeginInvoke(Sub() barraNivel.EsTx = False)
            If Not Me.IsDisposed AndAlso Me.IsHandleCreated Then
                Me.BeginInvoke(Sub()
                                   If finQso AndAlso txArmado Then
                                       FinDeQso()
                                   ElseIf txArmado Then
                                       lblTx.ForeColor = SystemColors.ControlText
                                       lblTx.Text = Tr("TX {0}/{1} hecha. Esperando el proximo ciclo...", transmisionesHechas, MaxTransmisiones)
                                   Else
                                       DesarmarTx(Tr("TX detenida"))
                                   End If
                               End Sub)
            End If
        End Try
    End Sub

    ' ==================================================================
    ' JTTY: texto libre sin ciclos (motor de WSJT-X 3.2 en jtty_pako.dll)
    ' ==================================================================
    ' Crea el motor la primera vez. Si falta la DLL, avisa y Pako sigue funcionando en FT8 / FT4.
    Private Function AsegurarJtty() As Boolean
        If jtty IsNot Nothing Then Return True
        Try
            jtty = New JttyMotor()
            Return True
        Catch ex As Exception
            jtty = Nothing
            Dim detalle As String = ex.Message
            If TypeOf ex Is DllNotFoundException Then detalle = Tr("No se encuentra jtty_pako.dll junto a Pako.exe.")
            If TypeOf ex Is BadImageFormatException Then detalle = Tr("jtty_pako.dll es de 64 bits: compila Pako para x64.")
            MessageBox.Show(Tr("No se puede usar JTTY: {0}", detalle), NombrePrograma, MessageBoxButtons.OK, MessageBoxIcon.Warning)
            Return False
        End Try
    End Function

    ' Arranca el hilo que decodifica (uno solo: el motor no admite llamadas simultaneas)
    Private Sub IniciarJtty()
        If Not AsegurarJtty() Then Return
        SyncLock jttyCola
            jttyCola.Clear()
        End SyncLock
        jttyReiniciar = True
        Dim h As New Thread(AddressOf JttyBucle) With {.IsBackground = True, .Name = "JTTY"}
        jttyHilo = h
        h.Start()
    End Sub

    ' Hilo de JTTY: cada 100 ms entrega el audio nuevo al motor y muestra lo que decodifico
    Private Sub JttyBucle()
        Dim yo As Thread = Thread.CurrentThread
        While jttyHilo Is yo
            Dim bloque As Short() = Nothing
            SyncLock jttyCola
                If jttyCola.Count >= SampleRate \ 10 Then
                    bloque = jttyCola.ToArray()
                    jttyCola.Clear()
                End If
            End SyncLock
            If bloque Is Nothing Then
                Thread.Sleep(20)
                Continue While
            End If

            Dim nuevos As List(Of JttyMensaje) = Nothing
            Try
                SyncLock jttyCandado
                    If jttyReiniciar Then
                        jttyReiniciar = False
                        jtty.Reiniciar()
                    End If
                    jtty.FrecRxHz = frecRx
                    nuevos = jtty.Recibir(bloque)
                End SyncLock
            Catch ex As Exception
                If jttyHilo Is yo Then jttyHilo = Nothing
                Dim mensaje As String = ex.Message
                If Not Me.IsDisposed AndAlso Me.IsHandleCreated Then
                    Me.BeginInvoke(Sub() AnotarServicio(Tr("JTTY: el decodificador se detuvo ({0})", mensaje), 2))
                End If
                Return
            End Try

            If nuevos.Count > 0 AndAlso jttyHilo Is yo AndAlso Not Me.IsDisposed AndAlso Me.IsHandleCreated Then
                Me.BeginInvoke(Sub() MostrarJtty(nuevos))
            End If
        End While
    End Sub

    ' Pone en la lista lo recibido. El mismo Id llega varias veces mientras el texto crece:
    ' se actualiza la linea que ya estaba en vez de agregar otra.
    Private Sub MostrarJtty(nuevos As List(Of JttyMensaje))
        Dim bandaAhora As String = Banda(DialMHz())
        Dim alFinal As Boolean = lstMensajes.TopIndex >= lstMensajes.Items.Count - (lstMensajes.ClientSize.Height \ lstMensajes.ItemHeight) - 1
        For Each m In nuevos
            If m.Texto = "" Then Continue For
            Dim d As Decodificado = Nothing
            If Not jttyLineas.TryGetValue(m.Id, d) OrElse Not lstMensajes.Items.Contains(d) Then
                d = New Decodificado With {.EsJtty = True, .Hora = DateTime.UtcNow}
                jttyLineas(m.Id) = d
                lstMensajes.Items.Add(d)
            End If
            d.Freq = m.FrecuenciaHz
            d.Texto = m.Texto
            d.Completo = m.Completo
            d.Emisor = EmisorJtty(m.Texto, False)
            d.Grid = ""
            d.Pais = Paises.Buscar(d.Emisor)
            d.Nuevo = If(d.Emisor = "", Novedad.Ninguna, Trabajados.Evaluar(d.Emisor, bandaAhora, "", d.Pais))
            If m.Completo Then jttyLineas.Remove(m.Id)
        Next
        If jttyLineas.Count > 200 Then jttyLineas.Clear()      ' mensajes que nunca se cerraron
        lstMensajes.Invalidate()
        If alFinal Then lstMensajes.TopIndex = Math.Max(0, lstMensajes.Items.Count - 1)
    End Sub

    Private Shared ReadOnly PatronIndicativo As New Regex("^([A-Z0-9]{1,4}/)?[A-Z0-9]{1,3}[0-9][A-Z]{1,4}(/[A-Z0-9]{1,4})?$")

    Private Shared Function PareceIndicativo(s As String) As Boolean
        Return s.Length >= 3 AndAlso PatronIndicativo.IsMatch(s)
    End Function

    ' Quien transmitio un mensaje de JTTY (es texto libre: se deduce por la forma).
    '   "CQ KA1ABC CQ", "TU KA1ABC CQ"  -> KA1ABC      "... DE KA1ABC" -> KA1ABC
    '   "TI2LX KA1ABC" (me llaman)      -> KA1ABC
    ' Con adivinar = True (doble clic) se toma ademas el ultimo indicativo que no sea el mio.
    Private Function EmisorJtty(texto As String, adivinar As Boolean) As String
        Dim t = texto.Split({" "c}, StringSplitOptions.RemoveEmptyEntries)
        Dim mi As String = MiCall
        Dim k As Integer = Array.IndexOf(t, "DE")
        If k >= 0 AndAlso k + 1 < t.Length AndAlso PareceIndicativo(t(k + 1)) Then Return t(k + 1)
        If Not adivinar AndAlso Array.IndexOf(t, "CQ") < 0 AndAlso Array.IndexOf(t, mi) < 0 Then Return ""
        For i As Integer = t.Length - 1 To 0 Step -1
            If t(i) <> mi AndAlso PareceIndicativo(t(i)) Then Return t(i)
        Next
        Return ""
    End Function

    ' Doble clic en un mensaje de JTTY: RX y TX a su frecuencia, y queda lista la llamada (F2)
    Private Sub ResponderJtty(d As Decodificado)
        If d.EsTx Then Return
        PonerFrecRx(d.Freq)
        If Not txEnCurso Then
            Dim f As Decimal = CDec(Math.Round(d.Freq))
            numFrecTx.Value = Math.Max(numFrecTx.Minimum, Math.Min(numFrecTx.Maximum, f))
        End If
        Dim quien As String = EmisorJtty(d.Texto, True)
        If quien = "" Then
            lblTx.ForeColor = SystemColors.ControlText
            lblTx.Text = Tr("No veo un indicativo en ese mensaje: escribe tu respuesta y presiona Enter.")
            txtMensaje.Focus()
            Return
        End If
        If quien <> dxCall Then
            TerminarQso()
            dxCall = quien
        End If
        MostrarQso()
        ' Si ya me esta llamando a mi, lo que sigue es el reporte (F3); si no, llamarlo (F2)
        Dim meLlama As Boolean = Array.IndexOf(d.Texto.Split(" "c), MiCall) >= 0
        txtMensaje.Text = TextoMacro(If(meLlama, 2, 1))
        txtMensaje.Focus()
        txtMensaje.SelectionStart = txtMensaje.TextLength
        lblTx.ForeColor = SystemColors.ControlText
        lblTx.Text = Tr("Listo para {0}: presiona Enter para transmitir.", dxCall)
    End Sub

    ' ---- Macros (F1 a F4) ----
    Private Shared ReadOnly Property NombresMacro As String()
        Get
            Return New String() {"CQ", Tr("Llamar"), "599", "TU 73"}
        End Get
    End Property

    Private Function TextoMacro(cual As Integer) As String
        Dim dx As String = dxCall
        Select Case cual
            Case 0 : Return "CQ " & MiCall & " CQ"
            Case 1 : Return (dx & " " & MiCall).Trim()
            Case 2 : Return (dx & " 599 " & MiGrid).Trim()
            Case Else : Return (dx & " TU 73").Trim()
        End Select
    End Function

    Private Sub Macro_Click(sender As Object, e As EventArgs)
        EnviarMacro(CInt(DirectCast(sender, Button).Tag))
    End Sub

    Private Sub EnviarMacro(cual As Integer)
        If Not modoJtty Then Return
        If cual > 0 AndAlso dxCall = "" Then
            lblTx.ForeColor = SystemColors.ControlText
            lblTx.Text = Tr("Primero doble clic en un mensaje de la estacion (o escribe el mensaje a mano).")
            Return
        End If
        If cual = 2 Then reporteEnviado = "599"
        TransmitirJtty(TextoMacro(cual))
    End Sub

    Private Sub Form1_KeyDown(sender As Object, e As KeyEventArgs) Handles MyBase.KeyDown
        If Not modoJtty OrElse e.Modifiers <> Keys.None Then Return
        If e.KeyCode >= Keys.F1 AndAlso e.KeyCode <= Keys.F4 Then
            e.Handled = True
            e.SuppressKeyPress = True
            EnviarMacro(CInt(e.KeyCode) - CInt(Keys.F1))
        ElseIf e.KeyCode = Keys.Escape AndAlso txEnCurso Then
            e.Handled = True
            DesarmarTx(Tr("Transmision cancelada"))
        End If
    End Sub

    ' Transmite un mensaje de JTTY ahora mismo (no hay ciclos que esperar)
    Private Sub TransmitirJtty(texto As String)
        texto = If(texto, "").Trim().ToUpperInvariant()
        If texto = "" Then Return
        If txEnCurso Then
            lblTx.ForeColor = SystemColors.ControlText
            lblTx.Text = Tr("Ya hay una transmision en curso (Esc o 'Cancelar TX' para cortarla).")
            Return
        End If
        If MiCall = "" Then
            MessageBox.Show(Tr("Escribe tu indicativo y tu grid en Configurar > Mi estacion."))
            Return
        End If
        If salidaSel < 0 Then
            MessageBox.Show(Tr("Elige la salida de audio en Configurar > Salida de audio."))
            Return
        End If
        If Not AsegurarJtty() Then Return
        If pruebaPttActiva Then TerminarPruebaPtt("")
        If tuneActivo Then DetenerTune("")

        ' Generar el audio (12000 muestras/s). Con split Fake It el tono baja y el VFO sube lo mismo.
        Dim desplazamiento As Integer = DesplazamientoSplit()
        Dim frecAudio As Single = CSng(numFrecTx.Value)
        Dim enviado As String = ""
        Dim onda As Single() = Nothing
        Try
            SyncLock jttyCandado
                onda = jtty.Transmitir(texto, frecAudio - desplazamiento, enviado)
            End SyncLock
        Catch ex As Exception
            MessageBox.Show(Tr("Error al transmitir: {0}", ex.Message))
            Return
        End Try
        If onda Is Nothing OrElse onda.Length = 0 Then
            MessageBox.Show(Tr("Ese texto no se puede enviar en JTTY (maximo {0} caracteres).", MaxLetrasJtty), NombrePrograma)
            Return
        End If
        If Not AbrirPuertoPtt() Then Return

        ' Lo que el QSO necesita recordar del mensaje
        Dim t = enviado.Split({" "c}, StringSplitOptions.RemoveEmptyEntries)
        If dxCall <> "" AndAlso Array.IndexOf(t, dxCall) >= 0 AndAlso Array.IndexOf(t, "599") >= 0 Then reporteEnviado = "599"

        txArmado = True               ' "Cancelar TX" y Esc lo ponen en False y la transmision se corta
        txEnCurso = True
        btnTx.Text = Tr("Cancelar TX")
        btnTx.BackColor = Color.Orange
        mnuSalida.Enabled = False
        numFrecTx.Enabled = False
        txtMensaje.Text = enviado
        txtMensaje.SelectAll()
        Dim segundos As Double = onda.Length / CDbl(SampleRate)
        lblTx.ForeColor = Color.Red
        lblTx.Text = String.Format("TX JTTY ({0:F0} s)  {1}", segundos, enviado)
        lstMensajes.Items.Add(New Decodificado With {.Hora = DateTime.UtcNow, .EsTx = True, .EsJtty = True, .Completo = True,
                                                     .Freq = frecAudio, .Texto = enviado})
        lstMensajes.TopIndex = Math.Max(0, lstMensajes.Items.Count - 1)

        Dim dispositivo As Integer = salidaSel
        Task.Run(Sub() TransmitirJttyFondo(onda, desplazamiento, dispositivo))
    End Sub

    ' Hilo de fondo: PTT, audio y soltar
    Private Sub TransmitirJttyFondo(onda As Single(), desplazamiento As Integer, dispositivo As Integer)
        Dim dialBase As Long = dialCatHz
        Dim cancelada As Boolean = False
        Try
            If Cat.Conectado AndAlso desplazamiento <> 0 AndAlso dialBase > 0 Then
                vfoDesplazado = True
                Cat.PonerFrecuencia(dialBase + desplazamiento)
            End If
            Ptt(True)
            Thread.Sleep(150)                       ' que el radio pase a TX antes del primer simbolo

            ' La tarjeta trabaja a 48 kHz: se remuestrea el audio de 12 kHz
            Dim fuente As New MuestrasFijas(onda, SampleRate, 0.9F)
            Dim a48 As New WdlResamplingSampleProvider(fuente, SampleRateTx)
            Dim conVolumen As New VolumeSampleProvider(a48) With {.Volume = volumenTx}
            volumenEnCurso = conVolumen
            Dim medidor As New MeteringSampleProvider(conVolumen, SampleRateTx \ 20)
            AddHandler medidor.StreamVolume, AddressOf MedidorTx_StreamVolume
            mostrandoTx = True
            Me.BeginInvoke(Sub() barraNivel.EsTx = True)

            Using salida As New WaveOutEvent()
                salida.DeviceNumber = dispositivo
                salida.DesiredLatency = 100
                salida.NumberOfBuffers = 2
                salida.Init(medidor, True)
                salida.Play()
                Dim limite As DateTime = DateTime.UtcNow.AddSeconds(onda.Length / CDbl(SampleRate) + 3)
                While salida.PlaybackState = PlaybackState.Playing AndAlso txArmado AndAlso DateTime.UtcNow < limite
                    Thread.Sleep(20)
                End While
                cancelada = Not txArmado
                If Not cancelada Then Thread.Sleep(80)   ' que termine de salir la cola del audio
                salida.Stop()
            End Using
            RemoveHandler medidor.StreamVolume, AddressOf MedidorTx_StreamVolume
        Catch ex As Exception
            cancelada = True
            If Not Me.IsDisposed AndAlso Me.IsHandleCreated Then
                Me.BeginInvoke(Sub() MessageBox.Show(Tr("Error al transmitir: {0}", ex.Message)))
            End If
        Finally
            volumenEnCurso = Nothing
            Ptt(False)
            If vfoDesplazado Then
                Cat.PonerFrecuencia(dialBase)
                vfoDesplazado = False
            End If
            txArmado = False
            txEnCurso = False
            mostrandoTx = False
            If Not Me.IsDisposed AndAlso Me.IsHandleCreated Then
                Me.BeginInvoke(Sub()
                                   barraNivel.EsTx = False
                                   DesarmarTx(If(cancelada, Tr("Transmision cancelada"), Tr("TX terminada. Escuchando...")))
                               End Sub)
            End If
        End Try
    End Sub

    ' ==================================================================
    ' TUNE: tono continuo en la frecuencia TX
    ' ==================================================================
    Private Sub btnTune_Click(sender As Object, e As EventArgs) Handles btnTune.Click
        If tuneActivo Then
            DetenerTune(Tr("Tune detenido"))
        Else
            IniciarTune()
        End If
    End Sub

    Private Sub IniciarTune()
        If txArmado OrElse txEnCurso Then
            MessageBox.Show(Tr("Cancela la transmision antes de usar Tune."), NombrePrograma)
            Return
        End If
        If salidaSel < 0 Then
            MessageBox.Show(Tr("Elige la salida de audio en Configurar > Salida de audio."), NombrePrograma)
            Return
        End If
        If pruebaPttActiva Then TerminarPruebaPtt("")
        If Not AbrirPuertoPtt() Then Return

        Try
            ' Seno a la misma amplitud que una senal FT8 (90 %), asi la potencia del Tune
            ' es la misma que tendra la transmision real con el mismo Nivel TX
            tuneGenerador = New SignalGenerator(SampleRateTx, 1) With {
                .Type = SignalGeneratorType.Sin,
                .Frequency = CDbl(numFrecTx.Value),
                .Gain = 0.9}
            Dim conVolumen As New VolumeSampleProvider(tuneGenerador) With {.Volume = volumenTx}
            volumenEnCurso = conVolumen                    ' el deslizador Nivel actua en vivo
            Dim medidor As New MeteringSampleProvider(conVolumen, SampleRateTx \ 20)
            AddHandler medidor.StreamVolume, AddressOf MedidorTx_StreamVolume

            tuneSalida = New WaveOutEvent() With {.DeviceNumber = salidaSel, .DesiredLatency = 100, .NumberOfBuffers = 2}
            tuneSalida.Init(medidor, True)
            Ptt(True)
            tuneSalida.Play()
        Catch ex As Exception
            DetenerTune("")
            CerrarPuertoPtt()
            MessageBox.Show(Tr("No se pudo iniciar Tune: {0}", ex.Message), NombrePrograma)
            Return
        End Try

        tuneActivo = True
        inicioTune = DateTime.UtcNow
        mostrandoTx = True
        barraNivel.EsTx = True
        btnTune.BackColor = Color.Red
        btnTune.ForeColor = Color.White
        btnTune.Text = "Tune  (" & MaxTuneSeg & " s)"
        btnTx.Enabled = False
        btnCQ.Enabled = False
        mnuSalida.Enabled = False
        lblTx.ForeColor = Color.Red
        lblTx.Text = Tr("TUNE: transmitiendo tono en {0} Hz. Clic en Tune para detenerlo.", numFrecTx.Value)
    End Sub

    Private Sub DetenerTune(motivo As String)
        Dim estaba As Boolean = tuneActivo
        tuneActivo = False
        Ptt(False)                                  ' primero soltar el PTT
        Try
            If tuneSalida IsNot Nothing Then
                tuneSalida.Stop()
                tuneSalida.Dispose()
            End If
        Catch
        End Try
        tuneSalida = Nothing
        tuneGenerador = Nothing
        volumenEnCurso = Nothing
        If Not estaba Then Return

        If Not txArmado Then CerrarPuertoPtt()
        mostrandoTx = False
        barraNivel.EsTx = False
        btnTune.BackColor = SystemColors.Control
        btnTune.ForeColor = SystemColors.ControlText
        btnTune.UseVisualStyleBackColor = True
        btnTune.Text = "Tune"
        btnTx.Enabled = True
        btnCQ.Enabled = True
        mnuSalida.Enabled = True
        If motivo <> "" Then
            lblTx.ForeColor = SystemColors.ControlText
            lblTx.Text = motivo
        End If
    End Sub

    ' Nivel de la senal que sale hacia el radio (hilo de audio)
    Private Sub MedidorTx_StreamVolume(sender As Object, e As StreamVolumeEventArgs)
        If Me.IsDisposed OrElse Not Me.IsHandleCreated Then Return
        Dim pico As Integer = CInt(e.MaxSampleValues(0) * 100)
        Me.BeginInvoke(Sub() barraNivel.Nivel = pico)
    End Sub

    Private Shared Sub EsperarHasta(momento As DateTime)
        Dim restante As TimeSpan = momento - DateTime.UtcNow
        If restante.TotalMilliseconds > 30 Then Thread.Sleep(restante.Subtract(TimeSpan.FromMilliseconds(20)))
        While DateTime.UtcNow < momento
            Thread.Sleep(1)
        End While
    End Sub

    ' Muestra la transmision en la lista (amarillo) y en la etiqueta
    Private Sub MostrarTx(plan As PlanTx, inicioCiclo As DateTime)
        If Me.IsDisposed OrElse Not Me.IsHandleCreated Then Return
        Me.BeginInvoke(Sub()
                           lblTx.ForeColor = Color.Red
                           lblTx.Text = String.Format("TX {0:HH:mm:ss}  {1}", inicioCiclo, plan.Texto)
                           Dim d As New Decodificado With {.Hora = inicioCiclo, .EsTx = True,
                                                           .Freq = CSng(numFrecTx.Value), .Texto = plan.Texto}
                           lstMensajes.Items.Add(d)
                           lstMensajes.TopIndex = Math.Max(0, lstMensajes.Items.Count - 1)
                       End Sub)
    End Sub

End Class

' ======================================================================
' Un mensaje en la lista (recibido o transmitido)
' ======================================================================
Public Class Decodificado
    Public Hora As DateTime
    Public Ciclo As Long
    Public Snr As Integer
    Public Dt As Single
    Public Freq As Single
    Public Texto As String = ""
    Public EsTx As Boolean
    Public Emisor As String = ""        ' quien transmitio el mensaje
    Public Grid As String = ""          ' su grid, si lo trae
    Public Pais As String = ""          ' pais (cty.dat)
    Public Nuevo As Novedad = Novedad.Ninguna
    Public Metodo As Integer            ' como se decodifico: 0 normal, 1 OSD, 11-16 AP
    Public EsJtty As Boolean            ' mensaje de JTTY (texto libre, sin dB ni DT)
    Public Completo As Boolean = True   ' JTTY: ya llego el fin del mensaje

    Public Overrides Function ToString() As String
        If EsJtty Then
            Return String.Format("{0:HHmmss} {1,-10} {2,5:F0}  {3}{4}", Hora, If(EsTx, "  TX", " JTTY"), Freq, Texto,
                                 If(Completo, "", " ..."))
        End If
        If EsTx Then
            Return String.Format("{0:HHmmss}   TX       {1,5:F0}  {2}", Hora, Freq, Texto)
        End If
        Return String.Format("{0:HHmmss} {1,4} {2,5:F1} {3,5:F0}  {4}", Hora, Snr, Dt, Freq, Texto)
    End Function
End Class

' ======================================================================
' Barra de nivel de audio: verde (bien), amarillo (alto), rojo (saturando)
' ======================================================================
Public Class BarraNivel
    Inherits Control

    Private nivelMostrado As Single = 0   ' con caida lenta, para que no parpadee
    Private modoTx As Boolean = False

    ' True: muestra el nivel de TX (azul). False: nivel de RX (verde/amarillo/rojo)
    Public Property EsTx As Boolean
        Get
            Return modoTx
        End Get
        Set(value As Boolean)
            If value <> modoTx Then
                modoTx = value
                nivelMostrado = 0
                Me.Invalidate()
            End If
        End Set
    End Property

    Public Sub New()
        Me.DoubleBuffered = True
        Me.SetStyle(ControlStyles.ResizeRedraw, True)
    End Sub

    ' Nivel de pico en % (0 a 100)
    Public Property Nivel As Integer
        Get
            Return CInt(nivelMostrado)
        End Get
        Set(value As Integer)
            Dim v As Single = Math.Max(0, Math.Min(100, value))
            nivelMostrado = If(v >= nivelMostrado, v, nivelMostrado * 0.8F + v * 0.2F)
            Me.Invalidate()
        End Set
    End Property

    Protected Overrides Sub OnPaint(e As PaintEventArgs)
        Dim g = e.Graphics
        Dim r = Me.ClientRectangle
        g.Clear(Color.FromArgb(40, 40, 40))

        ' Zona recomendada para RX: 30-50 % (fondo un poco mas claro)
        If Not modoTx Then
            Dim x30 As Integer = CInt(r.Width * 0.3), x50 As Integer = CInt(r.Width * 0.5)
            Using zona As New SolidBrush(Color.FromArgb(70, 70, 70))
                g.FillRectangle(zona, x30, 0, x50 - x30, r.Height)
            End Using
        End If

        ' Barra
        Dim ancho As Integer = CInt(r.Width * nivelMostrado / 100.0F)
        Dim colorBarra As Color
        If modoTx Then
            colorBarra = If(nivelMostrado < 98, Color.DodgerBlue, Color.Red)  ' rojo = recortando
        Else
            colorBarra = If(nivelMostrado < 60, Color.LimeGreen, If(nivelMostrado < 85, Color.Gold, Color.Red))
        End If
        Using pincel As New SolidBrush(colorBarra)
            g.FillRectangle(pincel, 0, 3, ancho, r.Height - 6)
        End Using

        ' Texto
        TextRenderer.DrawText(g, If(modoTx, "TX ", "RX ") & CInt(nivelMostrado) & "%", Me.Font, r, Color.White,
                              TextFormatFlags.HorizontalCenter Or TextFormatFlags.VerticalCenter)
        g.DrawRectangle(Pens.Gray, 0, 0, r.Width - 1, r.Height - 1)
    End Sub
End Class

' ======================================================================
' Waterfall: cada linea es un espectro; la mas nueva arriba.
' Eje horizontal = frecuencia de audio (FMin a FMax), color = intensidad.
' ======================================================================
Public Class Cascada
    Inherits Control

    Public Const ClicRx As Integer = 0
    Public Const ClicTx As Integer = 1
    Public Const ClicAmbos As Integer = 2
    Public Event ClicFrecuencia(frecuencia As Single, cual As Integer)

    Public FMin As Single = 200
    Public FMax As Single = 3000
    Private Const AltoEscala As Integer = 18

    Private bmp As Bitmap
    Private fila As Integer = 0                             ' fila donde esta la linea mas nueva
    Private etiquetas As New Dictionary(Of Integer, String) ' fila -> hora del ciclo
    Private ReadOnly candado As New Object()
    Private pisoRuido As Single = Single.NaN                 ' referencia de brillo (se ajusta sola)
    Private paleta(255) As Integer
    Private frecTxValor As Single = 1500
    Private frecRxValor As Single = 1500

    ' Frecuencia de RX (marca verde)
    Public Property FrecRx As Single
        Get
            Return frecRxValor
        End Get
        Set(value As Single)
            frecRxValor = value
            Me.Invalidate()
        End Set
    End Property
    Public AnchoTxHz As Single = 50       ' ancho de la senal propia (FT8 50 Hz, FT4 83 Hz)

    Public Sub New()
        Me.DoubleBuffered = True
        Me.BackColor = Color.Black
        Me.Cursor = Cursors.Cross
        ' Paleta: negro -> azul -> celeste -> amarillo -> rojo -> blanco
        Dim pos() As Single = {0.0F, 0.25F, 0.5F, 0.7F, 0.85F, 1.0F}
        Dim col() As Color = {Color.Black, Color.FromArgb(0, 0, 170), Color.FromArgb(0, 170, 255),
                              Color.Yellow, Color.FromArgb(255, 80, 0), Color.White}
        For i As Integer = 0 To 255
            Dim v As Single = i / 255.0F
            Dim k As Integer = 0
            While k < pos.Length - 2 AndAlso v > pos(k + 1)
                k += 1
            End While
            Dim t As Single = (v - pos(k)) / (pos(k + 1) - pos(k))
            Dim r As Integer = CInt(col(k).R + (CInt(col(k + 1).R) - col(k).R) * t)
            Dim g As Integer = CInt(col(k).G + (CInt(col(k + 1).G) - col(k).G) * t)
            Dim b As Integer = CInt(col(k).B + (CInt(col(k + 1).B) - col(k).B) * t)
            paleta(i) = Color.FromArgb(255, r, g, b).ToArgb()
        Next
    End Sub

    ' Frecuencia de TX (marca roja)
    Public Property FrecTx As Single
        Get
            Return frecTxValor
        End Get
        Set(value As Single)
            frecTxValor = value
            Me.Invalidate()
        End Set
    End Property

    Protected Overrides Sub OnResize(e As EventArgs)
        MyBase.OnResize(e)
        SyncLock candado
            bmp?.Dispose()
            bmp = Nothing
            If Me.Width > 0 AndAlso Me.Height > 0 Then
                bmp = New Bitmap(Me.Width, Me.Height, PixelFormat.Format32bppRgb)
                Using g = Graphics.FromImage(bmp)
                    g.Clear(Color.Black)
                End Using
            End If
            fila = 0
            etiquetas.Clear()
        End SyncLock
        Me.Invalidate()
    End Sub

    ' Agregar un espectro (dB por bin). Se puede llamar desde el hilo de audio.
    Public Sub AgregarLinea(db As Single(), hzPorBin As Single, etiqueta As String)
        SyncLock candado
            If bmp Is Nothing Then Return
            Dim ancho As Integer = bmp.Width
            Dim alto As Integer = bmp.Height

            ' Valor de cada pixel = maximo de los bins que caen en el
            Dim px(ancho - 1) As Single
            Dim span As Single = FMax - FMin
            For x As Integer = 0 To ancho - 1
                Dim b0 As Integer = CInt(Math.Floor((FMin + x * span / ancho) / hzPorBin))
                Dim b1 As Integer = Math.Max(b0, CInt(Math.Floor((FMin + (x + 1) * span / ancho) / hzPorBin)))
                Dim m As Single = Single.MinValue
                For b As Integer = b0 To Math.Min(b1, db.Length - 1)
                    If db(b) > m Then m = db(b)
                Next
                px(x) = m
            Next

            ' Piso de ruido = mediana de la linea, suavizada (brillo automatico)
            Dim orden = CType(px.Clone(), Single())
            Array.Sort(orden)
            Dim mediana As Single = orden(ancho \ 2)
            pisoRuido = If(Single.IsNaN(pisoRuido), mediana, pisoRuido * 0.95F + mediana * 0.05F)

            ' Colores: el ruido queda azul oscuro; +30 dB sobre el ruido = blanco
            Dim colores(ancho - 1) As Integer
            If etiqueta IsNot Nothing Then
                For x As Integer = 0 To ancho - 1
                    colores(x) = Color.FromArgb(0, 200, 0).ToArgb()   ' linea verde: inicio de ciclo
                Next
            Else
                For x As Integer = 0 To ancho - 1
                    Dim v As Single = (px(x) - pisoRuido + 3.0F) / 33.0F
                    Dim i As Integer = CInt(Math.Max(0, Math.Min(255, v * 255)))
                    colores(x) = paleta(i)
                Next
            End If

            ' Escribir en la fila siguiente (hacia arriba, circular)
            fila = (fila - 1 + alto) Mod alto
            etiquetas.Remove(fila)
            If etiqueta IsNot Nothing Then etiquetas(fila) = etiqueta
            Dim datos As BitmapData = bmp.LockBits(New Rectangle(0, fila, ancho, 1), ImageLockMode.WriteOnly, PixelFormat.Format32bppRgb)
            Marshal.Copy(colores, 0, datos.Scan0, ancho)
            bmp.UnlockBits(datos)
        End SyncLock
    End Sub

    Protected Overrides Sub OnPaint(e As PaintEventArgs)
        Dim g = e.Graphics
        SyncLock candado
            If bmp Is Nothing Then Return
            Dim ancho As Integer = bmp.Width, alto As Integer = bmp.Height
            ' Dos partes del buffer circular: de "fila" hacia abajo, y lo que dio la vuelta
            g.DrawImage(bmp, New Rectangle(0, 0, ancho, alto - fila), New Rectangle(0, fila, ancho, alto - fila), GraphicsUnit.Pixel)
            If fila > 0 Then
                g.DrawImage(bmp, New Rectangle(0, alto - fila, ancho, fila), New Rectangle(0, 0, ancho, fila), GraphicsUnit.Pixel)
            End If
            ' Hora de cada ciclo
            Using f As New Font("Consolas", 8)
                For Each kv In etiquetas
                    Dim y As Integer = (kv.Key - fila + alto) Mod alto
                    If y > AltoEscala Then TextRenderer.DrawText(g, kv.Value, f, New Point(2, y + 1), Color.White)
                Next
            End Using
        End SyncLock

        ' Escala de frecuencias arriba
        Dim span As Single = FMax - FMin
        Using fondo As New SolidBrush(Color.FromArgb(200, 25, 25, 25))
            g.FillRectangle(fondo, 0, 0, Me.Width, AltoEscala)
        End Using
        Using f As New Font("Segoe UI", 7.5F)
            For hz As Integer = CInt(Math.Ceiling(FMin / 100)) * 100 To CInt(FMax) Step 100
                Dim x As Integer = CInt((hz - FMin) / span * Me.Width)
                Dim largo As Integer = If(hz Mod 500 = 0, 6, 3)
                g.DrawLine(Pens.Silver, x, AltoEscala - largo, x, AltoEscala)
                If hz Mod 500 = 0 Then TextRenderer.DrawText(g, hz.ToString(), f, New Point(x + 2, 1), Color.White)
            Next
        End Using

        Dim anchoTx As Integer = Math.Max(2, CInt(AnchoTxHz / span * Me.Width))

        ' Marca de RX: rectangulo verde (arriba de la escala) y linea vertical
        Dim xRx As Integer = CInt((frecRxValor - FMin) / span * Me.Width)
        Using verde As New SolidBrush(Color.LimeGreen)
            g.FillRectangle(verde, xRx, 0, anchoTx, 5)
        End Using
        Using lineaRx As New Pen(Color.FromArgb(140, 0, 255, 0))
            g.DrawLine(lineaRx, xRx, AltoEscala, xRx, Me.Height)
        End Using

        ' Marca de TX: rectangulo rojo (abajo de la escala) y linea vertical
        Dim xTx As Integer = CInt((frecTxValor - FMin) / span * Me.Width)
        Using rojo As New SolidBrush(Color.Red)
            g.FillRectangle(rojo, xTx, AltoEscala - 5, anchoTx, 5)
        End Using
        Using linea As New Pen(Color.FromArgb(140, 255, 0, 0))
            g.DrawLine(linea, xTx, AltoEscala, xTx, Me.Height)
        End Using
    End Sub

    Protected Overrides Sub OnMouseDown(e As MouseEventArgs)
        MyBase.OnMouseDown(e)
        If Me.Width <= 0 Then Return
        Dim f As Single = FMin + e.X * (FMax - FMin) / Me.Width
        If e.Button = MouseButtons.Left AndAlso (Control.ModifierKeys And Keys.Control) = Keys.Control Then
            RaiseEvent ClicFrecuencia(f, ClicAmbos)
        ElseIf e.Button = MouseButtons.Left Then
            RaiseEvent ClicFrecuencia(f, ClicRx)
        ElseIf e.Button = MouseButtons.Right Then
            RaiseEvent ClicFrecuencia(f, ClicTx)
        End If
    End Sub

    Protected Overrides Sub OnMouseMove(e As MouseEventArgs)
        MyBase.OnMouseMove(e)
        If Me.Width <= 0 Then Return
        Dim hz As Integer = CInt(FMin + e.X * (FMax - FMin) / Me.Width)
        If Me.Tag Is Nothing OrElse CInt(Me.Tag) <> hz \ 10 Then
            Me.Tag = hz \ 10
            If ayuda Is Nothing Then ayuda = New ToolTip()
            ayuda.SetToolTip(Me, hz & " Hz   " & Tr("clic izq = RX (verde)   clic der = TX (rojo)   Ctrl+clic = ambos"))
        End If
    End Sub
    Private ayuda As ToolTip
End Class

' ======================================================================
' Audio ya generado (arreglo de muestras) como fuente para NAudio
' ======================================================================
Public Class MuestrasFijas
    Implements ISampleProvider

    Private ReadOnly datos As Single()
    Private ReadOnly ganancia As Single
    Private posicion As Integer = 0
    Private ReadOnly formato As WaveFormat

    Public Sub New(muestras As Single(), tasa As Integer, ganancia As Single)
        datos = muestras
        Me.ganancia = ganancia
        formato = NAudio.Wave.WaveFormat.CreateIeeeFloatWaveFormat(tasa, 1)
    End Sub

    Public ReadOnly Property WaveFormat As WaveFormat Implements ISampleProvider.WaveFormat
        Get
            Return formato
        End Get
    End Property

    Public Function Read(buffer As Single(), offset As Integer, count As Integer) As Integer Implements ISampleProvider.Read
        Dim n As Integer = Math.Min(count, datos.Length - posicion)
        For i As Integer = 0 To n - 1
            buffer(offset + i) = datos(posicion + i) * ganancia
        Next
        posicion += n
        Return n
    End Function
End Class
